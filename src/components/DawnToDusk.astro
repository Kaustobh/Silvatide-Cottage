---
import imagesManifest from '../data/images.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// 5 Diurnal Time Steps
const timeSteps = [
  {
    time: '05:40',
    phase: 'FIRST LIGHT',
    title: 'Dawn Mist on Lake Saimaa',
    desc: 'Pale morning mist rising across the mirror-calm water as the northern horizon awakens.',
    slug: 'dawn-mist-lake',
    isFramed: false,
    bgTone: '#0d1014'
  },
  {
    time: '08:15',
    phase: 'MORNING GOLD',
    title: 'Low Solar Warming',
    desc: 'Low golden sun warming the cantilevered cedar deck, glass balustrade, and morning coffee.',
    slug: 'deck-morning-gold',
    isFramed: false,
    bgTone: '#161412'
  },
  {
    time: '13:30',
    phase: 'HIGH SOLAR',
    title: 'Meridian Elevation',
    desc: 'Direct Nordic daylight accentuating the charred timber facade, dormer clerestory, and standing-seam zinc.',
    slug: 'front-elevation-day',
    isFramed: false,
    bgTone: '#181716'
  },
  {
    time: '19:45',
    phase: 'BLUE DUSK',
    title: 'Canoe & Dock Twilight',
    desc: 'Deep blue hour settles over the private shoreline, still water reflections, and cedar canoe.',
    slug: 'lake-dusk-dock',
    isFramed: true, // Museum passe-partout framing
    bgTone: '#0b0e13'
  },
  {
    time: '23:00',
    phase: 'MIDNIGHT FIRE',
    title: 'Starlight & Outdoor Hearth',
    desc: 'Starlit Finnish sky with glowing concrete firepit, illuminated interior glazing, and absolute stillness.',
    slug: 'deck-night-firepit',
    isFramed: false,
    bgTone: '#08090c'
  }
];

// Compare slider images
const dayCompare = imagesManifest['forest-entrance-day'];
const nightCompare = imagesManifest['forest-entrance-night'];
---

<section id="chapter-dawntodusk" class="dusk-section" data-tone="true" data-tone-bg="#0c0e12" data-tone-text="#ffffff">
  <!-- ==========================================
       PART 1: PINNED DIURNAL SOLAR CYCLE SCRUB
       ========================================== -->
  <div class="dusk-scrub-pin" id="duskScrubPin">
    <!-- Header HUD -->
    <div class="dusk-hud container">
      <div class="dusk-hud-left">
        <span class="dusk-eyebrow">CHAPTER IV · DAWN TO DUSK</span>
        <h2 class="dusk-title sv-reveal-heading">Diurnal Light Cycle</h2>
      </div>

      <!-- Precision Clock Card -->
      <div class="dusk-clock-card">
        <div class="clock-display">
          <span class="clock-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
          <span id="duskClockTime" class="clock-time">05:40</span>
        </div>
        <span id="duskClockPhase" class="clock-phase">FIRST LIGHT</span>
      </div>
    </div>

    <!-- Slides Stage -->
    <div class="dusk-stage">
      {timeSteps.map((step, idx) => (
        <div
          class={`dusk-slide ${step.isFramed ? 'is-framed-plate' : 'is-full-bleed'}`}
          data-index={idx}
          data-time={step.time}
          data-phase={step.phase}
          data-title={step.title}
          data-desc={step.desc}
          data-tone={step.bgTone}
          style={`opacity: ${idx === 0 ? '1' : '0'}; z-index: ${10 + idx};`}
        >
          {step.isFramed ? (
            <div class="plate-matting-wrap">
              <div class="plate-inner-frame">
                <picture>
                  <source srcset={`${baseUrl}/images/optimized/${step.slug}-1440.avif 1440w, ${baseUrl}/images/optimized/${step.slug}-960.avif 960w`} type="image/avif" />
                  <source srcset={`${baseUrl}/images/optimized/${step.slug}-1440.webp 1440w, ${baseUrl}/images/optimized/${step.slug}-960.webp 960w`} type="image/webp" />
                  <img
                    src={`${baseUrl}/images/optimized/${step.slug}-1440.webp`}
                    alt={step.title}
                    class="plate-photo"
                    loading="lazy"
                  />
                </picture>
              </div>
              <div class="plate-caption-strip">
                <span class="plate-archive-stamp">ARCHIVE PLATE IV · TWILIGHT WATER</span>
                <span class="plate-coords">61° 29' 48" N · LAKE SAIMAA</span>
              </div>
            </div>
          ) : (
            <div class="slide-media-wrap">
              <picture>
                <source srcset={`${baseUrl}/images/optimized/${step.slug}-2200.avif 2200w, ${baseUrl}/images/optimized/${step.slug}-1440.avif 1440w, ${baseUrl}/images/optimized/${step.slug}-960.avif 960w`} type="image/avif" />
                <source srcset={`${baseUrl}/images/optimized/${step.slug}-2200.webp 2200w, ${baseUrl}/images/optimized/${step.slug}-1440.webp 1440w, ${baseUrl}/images/optimized/${step.slug}-960.webp 960w`} type="image/webp" />
                <img
                  src={`${baseUrl}/images/optimized/${step.slug}-1440.webp`}
                  alt={step.title}
                  class="slide-img"
                  loading="lazy"
                />
              </picture>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom Caption Bar -->
    <div class="dusk-caption-bar container">
      <div class="caption-inner">
        <span class="step-indicator" id="duskStepIndicator">CYCLE 01 / 05</span>
        <h3 id="duskSlideTitle" class="dusk-slide-title">Dawn Mist on Lake Saimaa</h3>
        <p id="duskDesc" class="dusk-desc">
          Pale morning mist rising across the mirror-calm water as the northern horizon awakens.
        </p>
      </div>

      <div class="timeline-ticks" aria-hidden="true">
        {timeSteps.map((step, idx) => (
          <div class={`tick-mark ${idx === 0 ? 'active' : ''}`} data-index={idx}>
            <span class="tick-time">{step.time}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ==========================================
       PART 2: MINIMAL DAY / NIGHT COMPARE SLIDER
       ========================================== -->
  <div class="compare-section container">
    <div class="compare-header">
      <span class="compare-eyebrow">DIURNAL LIGHT STUDY</span>
      <h3 class="compare-title sv-reveal-heading">Forest Entrance at Noon & Midnight</h3>
      <p class="compare-desc">
        Drag the divider to observe how the natural pine canopy sunlight shifts into warm low-glare architectural sconces along the granite entry path.
      </p>
    </div>

    <div
      class="compare-slider-wrap"
      id="compareSliderWrap"
      role="region"
      aria-label="Day and Night forest entrance comparison slider"
    >
      <div class="compare-slider" id="compareSlider">
        <!-- Night Image (Bottom Layer) -->
        <div class="compare-layer night-layer">
          <picture>
            <source srcset={`${baseUrl}/images/optimized/forest-entrance-night-1440.avif 1440w, ${baseUrl}/images/optimized/forest-entrance-night-960.avif 960w`} type="image/avif" />
            <source srcset={`${baseUrl}/images/optimized/forest-entrance-night-1440.webp 1440w, ${baseUrl}/images/optimized/forest-entrance-night-960.webp 960w`} type="image/webp" />
            <img
              src={`${baseUrl}/images/optimized/forest-entrance-night-1440.webp`}
              alt={nightCompare.alt}
              class="compare-img"
              loading="lazy"
            />
          </picture>
          <span class="compare-tag night-tag">NIGHT · 22:45</span>
        </div>

        <!-- Day Image (Top Layer with Clip-path) -->
        <div class="compare-layer day-layer" id="compareDayLayer" style="clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);">
          <picture>
            <source srcset={`${baseUrl}/images/optimized/forest-entrance-day-1440.avif 1440w, ${baseUrl}/images/optimized/forest-entrance-day-960.avif 960w`} type="image/avif" />
            <source srcset={`${baseUrl}/images/optimized/forest-entrance-day-1440.webp 1440w, ${baseUrl}/images/optimized/forest-entrance-day-960.webp 960w`} type="image/webp" />
            <img
              src={`${baseUrl}/images/optimized/forest-entrance-day-1440.webp`}
              alt={dayCompare.alt}
              class="compare-img"
              loading="lazy"
            />
          </picture>
          <span class="compare-tag day-tag">DAY · 14:00</span>
        </div>

        <!-- Hairline Divider Handle -->
        <div
          class="compare-handle"
          id="compareHandle"
          style="left: 50%;"
          role="slider"
          aria-valuenow="50"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label="Comparison slider position"
          tabindex="0"
        >
          <div class="handle-line"></div>
          <div class="handle-thumb">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
          <div class="handle-line"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dusk-section {
    position: relative;
    width: 100%;
    background: #0c0e12;
    color: #ffffff;
    overflow: hidden;
  }

  /* Pinned Scrub Stage */
  .dusk-scrub-pin {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .dusk-hud {
    position: relative;
    z-index: 30;
    padding-top: 3.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .dusk-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .dusk-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0.4rem 0 0 0;
    color: #ffffff;
  }

  .dusk-clock-card {
    background: rgba(14, 16, 20, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 0.9rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .clock-display {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .clock-icon {
    display: flex;
    color: var(--accent, #e5a970);
  }

  .clock-time {
    font-family: monospace;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #ffffff;
    line-height: 1;
  }

  .clock-phase {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Stage Slides */
  .dusk-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }

  .dusk-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-media-wrap {
    width: 100%;
    height: 100%;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Curated Gallery Passe-Partout Matting for Step 4 */
  .plate-matting-wrap {
    width: 76vw;
    max-width: 1040px;
    background: #14161c;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 1.5rem 1.5rem 1.25rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plate-inner-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .plate-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .plate-caption-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0.5rem;
  }

  .plate-archive-stamp {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--accent, #e5a970);
  }

  .plate-coords {
    font-family: monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.45);
  }

  /* Bottom Caption Bar */
  .dusk-caption-bar {
    position: relative;
    z-index: 30;
    padding-bottom: 3.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }

  .caption-inner {
    max-width: 580px;
    background: rgba(14, 16, 20, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.4rem 1.8rem;
    border-radius: 20px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .step-indicator {
    display: inline-block;
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--accent, #e5a970);
    margin-bottom: 0.35rem;
  }

  .dusk-slide-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 0.4rem 0;
  }

  .dusk-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .timeline-ticks {
    display: flex;
    gap: 1.5rem;
    background: rgba(14, 16, 20, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
  }

  .tick-mark {
    position: relative;
    cursor: pointer;
    opacity: 0.4;
    transition: all 0.3s ease;
  }

  .tick-mark.active {
    opacity: 1;
  }

  .tick-time {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .tick-mark.active .tick-time {
    color: var(--accent, #e5a970);
  }

  /* ============================================================
     DAY / NIGHT COMPARE SLIDER
     ============================================================ */
  .compare-section {
    padding: 8rem 1.5rem 8rem;
  }

  .compare-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }

  .compare-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .compare-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0.5rem 0 0.8rem;
  }

  .compare-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .compare-slider-wrap {
    max-width: 1200px;
    margin: 0 auto;
  }

  .compare-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 28px;
    overflow: hidden;
    user-select: none;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .compare-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .compare-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }

  .compare-tag {
    position: absolute;
    bottom: 2rem;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    z-index: 5;
  }

  .day-tag {
    left: 2rem;
    background: rgba(255, 255, 255, 0.9);
    color: #1a1a1a;
  }

  .night-tag {
    right: 2rem;
    background: rgba(10, 11, 14, 0.9);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* Hairline Divider Handle */
  .compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 36px;
    margin-left: -18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 20;
    cursor: ew-resize;
    outline: none;
  }

  .handle-line {
    width: 1px;
    flex: 1;
    background: #ffffff;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.6);
  }

  .handle-thumb {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    color: #101114;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .compare-handle:hover .handle-thumb {
    transform: scale(1.12);
    background: var(--accent, #e5a970);
  }

  /* Responsive */
  @media (max-width: 992px) {
    .dusk-hud {
      padding-top: 2rem;
      flex-direction: column;
      gap: 1.25rem;
    }

    .dusk-caption-bar {
      padding-bottom: 2rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .plate-matting-wrap {
      width: 90vw;
      padding: 1rem;
    }

    .timeline-ticks {
      display: none;
    }

    .compare-section {
      padding: 5rem 1.5rem 5rem;
    }

    .compare-slider {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dusk-scrub-pin {
      height: auto;
    }
    .dusk-stage {
      position: relative;
      height: 60vh;
    }
    .dusk-slide {
      opacity: 1 !important;
      position: relative;
      height: 60vh;
      margin-bottom: 2rem;
    }
    .dusk-slide:not(:first-child) {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initDawnToDusk() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Pinned Time of Day Scrub
    const scrubPin = document.getElementById('duskScrubPin');
    const slides = Array.from(document.querySelectorAll<HTMLElement>('.dusk-slide'));
    const clockTime = document.getElementById('duskClockTime');
    const clockPhase = document.getElementById('duskClockPhase');
    const titleEl = document.getElementById('duskSlideTitle');
    const descEl = document.getElementById('duskDesc');
    const indicatorEl = document.getElementById('duskStepIndicator');
    const ticks = Array.from(document.querySelectorAll<HTMLElement>('.tick-mark'));

    if (scrubPin && slides.length > 0 && !prefersReducedMotion) {
      const totalSteps = slides.length;

      ScrollTrigger.create({
        trigger: scrubPin,
        pin: true,
        start: 'top top',
        end: () => `+=${window.innerHeight * 3}`,
        scrub: 0.6,
        anticipatePin: 1,
        onUpdate: (self) => {
          const progress = self.progress;
          const rawIdx = progress * (totalSteps - 1);
          const currentIdx = Math.min(Math.floor(rawIdx), totalSteps - 1);
          const nextIdx = Math.min(currentIdx + 1, totalSteps - 1);
          const blend = rawIdx - currentIdx;

          // Smooth dissolves
          slides.forEach((slide, idx) => {
            if (idx === currentIdx) {
              slide.style.opacity = `${1 - blend}`;
            } else if (idx === nextIdx) {
              slide.style.opacity = `${blend}`;
            } else {
              slide.style.opacity = '0';
            }
          });

          const activeIdx = blend > 0.5 ? nextIdx : currentIdx;
          const activeSlide = slides[activeIdx];

          if (activeSlide) {
            const time = activeSlide.dataset.time || '05:40';
            const phase = activeSlide.dataset.phase || 'FIRST LIGHT';
            const title = activeSlide.dataset.title || '';
            const desc = activeSlide.dataset.desc || '';

            if (clockTime && clockTime.textContent !== time) clockTime.textContent = time;
            if (clockPhase && clockPhase.textContent !== phase) clockPhase.textContent = phase;
            if (titleEl && titleEl.textContent !== title) titleEl.textContent = title;
            if (descEl && descEl.textContent !== desc) descEl.textContent = desc;
            if (indicatorEl) indicatorEl.textContent = `CYCLE 0${activeIdx + 1} / 05`;

            ticks.forEach((tick, idx) => {
              tick.classList.toggle('active', idx === activeIdx);
            });
          }
        }
      });
    }

    // 2. Day / Night Compare Slider
    initCompareSlider();
  }

  function initCompareSlider() {
    const slider = document.getElementById('compareSlider');
    const dayLayer = document.getElementById('compareDayLayer');
    const handle = document.getElementById('compareHandle');
    if (!slider || !dayLayer || !handle) return;

    let isDragging = false;
    let currentPct = 50;

    const updatePosition = (pct: number) => {
      const clamped = Math.max(0, Math.min(100, pct));
      currentPct = clamped;
      dayLayer.style.clipPath = `polygon(0 0, ${clamped}% 0, ${clamped}% 100%, 0 100%)`;
      handle.style.left = `${clamped}%`;
      handle.setAttribute('aria-valuenow', Math.round(clamped).toString());
    };

    const onPointerMove = (e: PointerEvent) => {
      if (!isDragging) return;
      const rect = slider.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const pct = (x / rect.width) * 100;
      updatePosition(pct);
    };

    const onPointerUp = () => {
      isDragging = false;
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
    };

    const onPointerDown = (e: PointerEvent) => {
      isDragging = true;
      const rect = slider.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const pct = (x / rect.width) * 100;
      updatePosition(pct);
      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', onPointerUp);
    };

    slider.addEventListener('pointerdown', onPointerDown);

    // Keyboard support
    handle.addEventListener('keydown', (e: KeyboardEvent) => {
      let delta = 0;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') delta = -5;
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') delta = 5;
      else if (e.key === 'Home') delta = -100;
      else if (e.key === 'End') delta = 100;

      if (delta !== 0) {
        e.preventDefault();
        updatePosition(currentPct + delta);
      }
    });

    // One-time auto-demo swipe on first view
    let hasDemoed = false;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasDemoed) {
            hasDemoed = true;
            observer.disconnect();

            const obj = { val: 50 };
            gsap.timeline({ delay: 0.3 })
              .to(obj, {
                val: 72,
                duration: 0.85,
                ease: 'power2.inOut',
                onUpdate: () => updatePosition(obj.val)
              })
              .to(obj, {
                val: 28,
                duration: 1.05,
                ease: 'power2.inOut',
                onUpdate: () => updatePosition(obj.val)
              })
              .to(obj, {
                val: 50,
                duration: 0.75,
                ease: 'power3.out',
                onUpdate: () => updatePosition(obj.val)
              });
          }
        });
      },
      { threshold: 0.4 }
    );

    observer.observe(slider);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDawnToDusk);
  } else {
    initDawnToDusk();
  }

  document.addEventListener('astro:page-load', initDawnToDusk);
</script>
