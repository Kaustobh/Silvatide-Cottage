---
import fs from 'fs';
import path from 'path';

// Read manifest
let manifest = {
  desktop: { count: 120, width: 1280, height: 720, pattern: 'frame-%04d.webp' },
  mobile: { count: 60, width: 720, height: 405, pattern: 'mobile/frame-%04d.webp' },
  milestones: [
    { index: 0, label: '01. Site & Topography', copy: 'Ancient granite contours capture the low Nordic sun across still water.' },
    { index: 38, label: '02. Structural Framing', copy: 'Larch timber post-and-beam system and exposed roof trusses.' },
    { index: 78, label: '03. Weather Envelope', copy: 'Standing-seam zinc roof, charred vertical cladding, and solar glazing.' },
    { index: 110, label: '04. Lived-in Retreat', copy: 'Cottage completed on the lake shore with private terrace and canoe.' }
  ]
};

try {
  const manifestPath = path.join(process.cwd(), 'public/frames/blueprint/manifest.json');
  if (fs.existsSync(manifestPath)) {
    manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
  }
} catch (e) {
  // Fallback to default
}

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo7 = `${baseUrl}/images/optimized/front-elevation-day-1440.webp`;
---

<section id="chapter-drawing" class="blueprint-section" data-tone="true" data-tone-bg="#0c0e12" data-tone-text="#f0f2f5">
  <div class="bp-pin-wrap" id="bpPinWrap">
    <!-- Subtle Architectural Background Guidelines -->
    <div class="bp-grid-overlay" aria-hidden="true"></div>

    <!-- Architectural Editorial Title Header -->
    <div class="bp-header">
      <span class="bp-eyebrow">CHAPTER I · THE GENESIS</span>
      <h2 class="bp-title sv-reveal-heading">From Drafting Ink to Living Retreat</h2>
      <p class="bp-subtitle">Watch the structural timber, insulation envelope, and gabled roof materialize over ancient lakeside granite.</p>
    </div>

    <!-- Canvas Viewport with Photo 7 Wipe -->
    <div class="bp-viewport">
      <canvas id="bpCanvas" class="bp-canvas" aria-label="Architectural building assembly sequence"></canvas>
      
      <!-- Hand-off target photo 7 (aligned wipe) -->
      <div id="bpPhotoTarget" class="bp-photo-target" style={`background-image: url('${photo7}')`} aria-hidden="true"></div>
      
      <div class="bp-dpr-poster" id="bpPoster" style={`background-image: url('${baseUrl}/frames/blueprint/frame-0000.webp')`}></div>
    </div>

    <!-- Editorial Milestone HUD -->
    <div class="bp-hud">
      <div class="bp-caption-card" aria-live="polite">
        <div class="bp-meta-row">
          <span class="bp-milestone-pill" id="bpMilestoneTag">01. SITE & TOPOGRAPHY</span>
          <span class="bp-step-number" id="bpStepNumber">PHASE 01 / 04</span>
        </div>
        <p class="bp-caption-text" id="bpCaption">Ancient granite contours capture the low Nordic sun across still water.</p>
      </div>

      <div class="bp-progress-track">
        <div class="bp-progress-fill" id="bpProgressFill"></div>
      </div>

      <div class="bp-scrub-indicator">
        <span class="bp-scrub-text">SCROLL TO CONSTRUCT</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
      </div>
    </div>
  </div>
</section>

<style>
  .blueprint-section {
    position: relative;
    width: 100%;
    background: #0c0e12;
    color: #f0f2f5;
    overflow: hidden;
  }

  .bp-pin-wrap {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 3rem 4rem;
    overflow: hidden;
  }

  .bp-grid-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.04;
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.4) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.4) 1px, transparent 1px);
    z-index: 1;
  }

  /* Header */
  .bp-header {
    position: relative;
    z-index: 10;
    max-width: 640px;
  }

  .bp-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .bp-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0.4rem 0 0.5rem 0;
    color: #ffffff;
  }

  .bp-subtitle {
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  /* Viewport */
  .bp-viewport {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bp-canvas {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 3;
    pointer-events: none;
  }

  .bp-photo-target {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 4;
    pointer-events: none;
    clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
    transition: clip-path 0.05s linear;
  }

  .bp-dpr-poster {
    position: absolute;
    inset: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* Milestone HUD */
  .bp-hud {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }

  .bp-caption-card {
    background: rgba(14, 16, 20, 0.68);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.25rem 1.6rem;
    max-width: 520px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .bp-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .bp-milestone-pill {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .bp-step-number {
    font-family: monospace;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .bp-caption-text {
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  .bp-progress-track {
    flex: 1;
    max-width: 240px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 1.2rem;
  }

  .bp-progress-fill {
    width: 0%;
    height: 100%;
    background: var(--accent, #e5a970);
    box-shadow: 0 0 8px rgba(229, 169, 112, 0.8);
    transition: width 0.05s linear;
  }

  .bp-scrub-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 0.8rem;
    animation: gentleBob 2s infinite ease-in-out;
  }

  @keyframes gentleBob {
    0%, 100% { transform: translateY(0); opacity: 0.45; }
    50% { transform: translateY(4px); opacity: 0.85; }
  }

  /* Responsive */
  @media (max-width: 992px) {
    .bp-pin-wrap {
      padding: 2rem 1.5rem;
    }
    .bp-hud {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .bp-progress-track {
      max-width: 100%;
      width: 100%;
      margin-bottom: 0;
    }
    .bp-scrub-indicator {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-pin-wrap {
      height: auto;
      padding: 4rem 1.5rem;
    }
    .bp-canvas {
      display: none;
    }
    .bp-photo-target {
      position: relative;
      height: 60vh;
      clip-path: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initBlueprintScrub() {
    const section = document.getElementById('chapter-drawing');
    const pinWrap = document.getElementById('bpPinWrap');
    const canvas = document.getElementById('bpCanvas') as HTMLCanvasElement;
    const photoTarget = document.getElementById('bpPhotoTarget');
    const tagEl = document.getElementById('bpMilestoneTag');
    const captionEl = document.getElementById('bpCaption');
    const fillEl = document.getElementById('bpProgressFill');
    const stepEl = document.getElementById('bpStepNumber');

    if (!section || !pinWrap || !canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const baseUrl = (import.meta as any).env.BASE_URL.replace(/\/$/, '');
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const totalFrames = isMobile ? 60 : 120;
    const frameFolder = isMobile ? `${baseUrl}/frames/blueprint/mobile` : `${baseUrl}/frames/blueprint`;
    
    // Milestones
    const milestones = [
      { progress: 0.00, tag: '01. SITE & TOPOGRAPHY', step: 'PHASE 01 / 04', text: 'Ancient granite contours capture the low Nordic sun across still water.' },
      { progress: 0.32, tag: '02. STRUCTURAL FRAMING', step: 'PHASE 02 / 04', text: 'Larch timber post-and-beam system and exposed roof trusses.' },
      { progress: 0.65, tag: '03. WEATHER ENVELOPE', step: 'PHASE 03 / 04', text: 'Standing-seam zinc roof, charred vertical cladding, and solar glazing.' },
      { progress: 0.88, tag: '04. LIVED-IN RETREAT', step: 'PHASE 04 / 04', text: 'Cottage completed on the lake shore with private terrace and canoe.' }
    ];

    // Frame preloading
    const images: HTMLImageElement[] = [];
    let loadedCount = 0;
    let currentDrawnIndex = -1;

    canvas.width = isMobile ? 720 : 1280;
    canvas.height = isMobile ? 405 : 720;

    for (let i = 0; i < totalFrames; i++) {
      const img = new Image();
      const pad = String(i).padStart(4, '0');
      img.src = `${frameFolder}/frame-${pad}.webp`;
      img.onload = () => {
        loadedCount++;
        if (i === 0 && currentDrawnIndex === -1) {
          drawFrame(0);
        }
      };
      images.push(img);
    }

    function drawFrame(idx: number) {
      if (idx === currentDrawnIndex) return;
      const img = images[idx];
      if (img && img.complete) {
        ctx?.clearRect(0, 0, canvas.width, canvas.height);
        ctx?.drawImage(img, 0, 0, canvas.width, canvas.height);
        currentDrawnIndex = idx;
      }
    }

    // ScrollTrigger Pinned Scrub (~400svh)
    ScrollTrigger.create({
      trigger: section,
      pin: pinWrap,
      start: 'top top',
      end: '+=400%',
      scrub: 0.5,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const p = self.progress;

        // Progress bar fill
        if (fillEl) fillEl.style.width = `${p * 100}%`;

        // Frame selection
        const targetFrame = Math.min(Math.floor(p * totalFrames), totalFrames - 1);
        drawFrame(targetFrame);

        // Milestone captions update
        let activeM = milestones[0];
        for (const m of milestones) {
          if (p >= m.progress) activeM = m;
        }

        if (tagEl && tagEl.textContent !== activeM.tag) tagEl.textContent = activeM.tag;
        if (captionEl && captionEl.textContent !== activeM.text) captionEl.textContent = activeM.text;
        if (stepEl && stepEl.textContent !== activeM.step) stepEl.textContent = activeM.step;

        // Seamless wipe into Photo 7 at final stretch [0.85 -> 1.0]
        if (photoTarget) {
          if (p >= 0.85) {
            const wipePct = Math.min(100, ((p - 0.85) / 0.15) * 100);
            photoTarget.style.clipPath = `polygon(0 0, ${wipePct}% 0, ${wipePct}% 100%, 0 100%)`;
          } else {
            photoTarget.style.clipPath = 'polygon(0 0, 0 0, 0 100%, 0 100%)';
          }
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlueprintScrub);
  } else {
    initBlueprintScrub();
  }

  document.addEventListener('astro:page-load', initBlueprintScrub);
</script>
