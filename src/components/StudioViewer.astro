---
import { studioConfig } from '../config/studio';
import imagesManifest from '../data/images.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const posterUrl = `${baseUrl}/images/optimized/front-elevation-day-1440.webp`;

const layerChips = [
  { id: 'all', label: 'All Layers' },
  { id: 'layer_foundation', label: 'Foundation' },
  { id: 'layer_floors', label: 'Deck & Slabs' },
  { id: 'layer_walls_interior', label: 'Walls & Living' },
  { id: 'layer_upper', label: 'Upper Loft' },
  { id: 'layer_truss', label: 'Roof Trusses' },
  { id: 'layer_roof', label: 'Zinc Roof' }
];
---

<section id="chapter-studio" class="studio-section" data-tone="true" data-tone-bg="#0c0e12" data-tone-text="#ffffff">
  <div class="studio-container">
    <!-- Header -->
    <div class="studio-header">
      <div class="studio-header-left">
        <span class="studio-eyebrow">CHAPTER II · 3D STUDIO</span>
        <h2 class="studio-title sv-reveal-heading">Spatial Anatomy & Tectonic Isolation</h2>
      </div>
      <p class="studio-desc">
        Interact with the physical layers of Silvatide Cottage. Explode the vertical envelope, isolate individual construction tiers, or execute an internal section cut.
      </p>
    </div>

    <!-- 3D Canvas Viewport -->
    <div class="studio-viewport-wrap" id="studioViewportWrap">
      <canvas id="studioCanvas" class="studio-canvas" aria-label="Interactive 3D Architectural Cottage Studio"></canvas>

      <!-- Poster / Loading State -->
      <div id="studioPoster" class="studio-poster" style={`background-image: url('${posterUrl}')`}>
        <div class="studio-loader-card">
          <div class="loader-spinner"></div>
          <span class="loader-text">Loading 3D Tectonic Model...</span>
        </div>
      </div>

      <!-- Mobile Tap-to-Interact Overlay -->
      <div id="studioTouchOverlay" class="studio-touch-overlay">
        <button id="btnTouchInteract" class="touch-interact-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          TAP TO EXPLORE 3D SCENE
        </button>
      </div>

      <!-- Hotspot Overlay Pins (projected from 3D) -->
      <div id="studioHotspotsContainer" class="studio-hotspots">
        {studioConfig.hotspots.map((h) => (
          <button class="hotspot-pin" data-id={h.id} data-slug={h.imageSlug} aria-label={`Inspect ${h.name}`}>
            <span class="hotspot-pulse"></span>
            <span class="hotspot-dot"></span>
            <span class="hotspot-label">{h.name}</span>
          </button>
        ))}
      </div>

      <!-- Hotspot Detail Modal / Card -->
      <div id="hotspotCard" class="hotspot-modal" hidden>
        <div class="hotspot-modal-inner">
          <button id="btnCloseHotspot" class="modal-close" aria-label="Close modal">&times;</button>
          <div class="hotspot-modal-media">
            <img id="hotspotModalImg" src="" alt="" loading="lazy" />
          </div>
          <div class="hotspot-modal-body">
            <span class="hotspot-modal-tag">ARCHITECTURAL IMPRESSION</span>
            <h3 id="hotspotModalTitle" class="hotspot-modal-title"></h3>
            <p id="hotspotModalDesc" class="hotspot-modal-desc"></p>
          </div>
        </div>
      </div>

      <!-- Studio Floating Control Deck -->
      <div class="studio-controls-deck">
        <!-- Layer Selection Chips -->
        <div class="ctrl-group ctrl-layers-row">
          <span class="ctrl-group-label">LAYERS:</span>
          <div class="layer-chips-scroll">
            {layerChips.map((chip, idx) => (
              <button class={`layer-chip ${idx === 0 ? 'active' : ''}`} data-layer={chip.id}>
                {chip.label}
              </button>
            ))}
          </div>
        </div>

        <div class="ctrl-row-bottom">
          <!-- Explode Scrub Control -->
          <div class="ctrl-group ctrl-explode">
            <span class="ctrl-label">EXPLODE:</span>
            <input type="range" id="explodeRange" min="0" max="1" step="0.01" value="0" aria-label="Explode cottage layers" />
            <button id="btnResetView" class="ctrl-icon-btn" title="Reset View" aria-label="Reset Camera and Assembly">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            </button>
          </div>

          <!-- Mode Presets -->
          <div class="ctrl-group ctrl-modes">
            <button id="btnDollhouse" class="ctrl-mode-btn" data-mode="dollhouse">DOLLHOUSE</button>
            <button id="btnSectionCut" class="ctrl-mode-btn" data-mode="section">SECTION CUT</button>
          </div>

          <!-- Camera Views -->
          <div class="ctrl-group ctrl-views">
            {studioConfig.cameraPresets.map((p) => (
              <button class="ctrl-cam-btn" data-preset={p.id} title={`${p.label} (Key ${p.key})`}>
                {p.label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let isStudioInitialized = false;

  async function loadStudioModule() {
    if (isStudioInitialized) return;
    const canvas = document.getElementById('studioCanvas') as HTMLCanvasElement;
    if (!canvas) return;

    isStudioInitialized = true;

    // Dynamic lazy-load Three.js and dependencies
    const [THREE, { OrbitControls }, { GLTFLoader }, { MeshoptDecoder }, { gsap }, { studioConfig }] = await Promise.all([
      import('three'),
      import('three/examples/jsm/controls/OrbitControls.js'),
      import('three/examples/jsm/loaders/GLTFLoader.js'),
      import('meshoptimizer'),
      import('gsap'),
      import('../config/studio')
    ]);

    const poster = document.getElementById('studioPoster');
    const touchOverlay = document.getElementById('studioTouchOverlay');
    const btnTouch = document.getElementById('btnTouchInteract');
    const explodeRange = document.getElementById('explodeRange') as HTMLInputElement;
    const btnReset = document.getElementById('btnResetView');
    const btnDollhouse = document.getElementById('btnDollhouse');
    const btnSectionCut = document.getElementById('btnSectionCut');
    const layerChips = document.querySelectorAll<HTMLButtonElement>('.layer-chip');
    const camButtons = document.querySelectorAll<HTMLButtonElement>('.ctrl-cam-btn');
    const hotspotPins = document.querySelectorAll<HTMLButtonElement>('.hotspot-pin');
    const hotspotModal = document.getElementById('hotspotCard');
    const hotspotModalImg = document.getElementById('hotspotModalImg') as HTMLImageElement;
    const hotspotModalTitle = document.getElementById('hotspotModalTitle');
    const hotspotModalDesc = document.getElementById('hotspotModalDesc');
    const btnCloseHotspot = document.getElementById('btnCloseHotspot');

    const baseUrl = (import.meta as any).env.BASE_URL.replace(/\/$/, '');

    // Setup Renderer
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: window.innerWidth > 768,
      powerPreference: 'high-performance',
      alpha: true
    });

    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.localClippingEnabled = true;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0c0e12);

    // Camera & Controls
    const camera = new THREE.PerspectiveCamera(40, canvas.clientWidth / canvas.clientHeight, 0.05, 50);
    camera.position.set(0.9, 0.6, 1.1);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.maxPolarAngle = Math.PI / 2 + 0.05;
    controls.minDistance = 0.4;
    controls.maxDistance = 3.5;

    // High-End Nordic Lighting
    const hemiLight = new THREE.HemisphereLight(0xfff8ee, 0x2c221a, 1.3);
    scene.add(hemiLight);

    const sun = new THREE.DirectionalLight(0xffecd2, 2.5);
    sun.position.set(5, 8, 4);
    scene.add(sun);

    const skyFill = new THREE.DirectionalLight(0x7890a8, 0.9);
    skyFill.position.set(-5, 3, -3);
    scene.add(skyFill);

    const groundBounce = new THREE.DirectionalLight(0x3a3028, 0.5);
    groundBounce.position.set(0, -3, 0);
    scene.add(groundBounce);

    // Floor Contact Shadow Plane
    const shadowGeo = new THREE.PlaneGeometry(2.5, 2.5);
    const shadowMat = new THREE.MeshBasicMaterial({
      color: 0x050608,
      transparent: true,
      opacity: 0.4,
      depthWrite: false
    });
    const shadowPlane = new THREE.Mesh(shadowGeo, shadowMat);
    shadowPlane.rotation.x = -Math.PI / 2;
    shadowPlane.position.y = -0.42;
    scene.add(shadowPlane);

    // Section Clipping Plane
    const clipPlane = new THREE.Plane(new THREE.Vector3(0, -1, 0), 10.0); // inactive initially

    // Load Split Layers Model & Metadata
    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);

    let model: any = null;
    const layerNodes: { [key: string]: any } = {};
    let layerOffsets: { [key: string]: number } = {};
    let isRenderDemandActive = true;
    let renderDemandTimer = 0;

    function requestRender(durationMs = 1200) {
      isRenderDemandActive = true;
      clearTimeout(renderDemandTimer);
      renderDemandTimer = window.setTimeout(() => {
        isRenderDemandActive = false;
      }, durationMs);
    }

    try {
      const [layersRes, gltf] = await Promise.all([
        fetch(`${baseUrl}/models/layers.json`).then(r => r.json()),
        loader.loadAsync(`${baseUrl}/models/cottage-split-layers.glb`)
      ]);

      for (const l of layersRes.layers) {
        layerOffsets[l.name] = l.assembledY || 0;
      }

      model = gltf.scene;

      // Center model
      const box = new THREE.Box3().setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      model.position.sub(center);

      // Setup layer nodes
      model.traverse((child: any) => {
        if (child.name && layerOffsets[child.name] !== undefined) {
          layerNodes[child.name] = child;
        }
      });

      // Luxury Architectural Museum Model Materials (Eliminates AI texture mush!)
      const architecturalMaterials: { [key: string]: any } = {
        layer_foundation: new THREE.MeshStandardMaterial({
          color: 0x1a1c22, // Honed Nordic dark granite slate
          roughness: 0.85,
          metalness: 0.1,
          side: THREE.DoubleSide
        }),
        layer_floors: new THREE.MeshStandardMaterial({
          color: 0x9b7852, // Oiled Finnish cedar decking
          roughness: 0.65,
          metalness: 0.05,
          side: THREE.DoubleSide
        }),
        layer_walls_interior: new THREE.MeshStandardMaterial({
          color: 0x16181d, // Charred Yakisugi / Shou Sugi Ban timber
          roughness: 0.52,
          metalness: 0.18,
          side: THREE.DoubleSide
        }),
        layer_upper: new THREE.MeshStandardMaterial({
          color: 0xc2a37b, // Blonde Scandinavian birch loft
          roughness: 0.62,
          metalness: 0.05,
          side: THREE.DoubleSide
        }),
        layer_truss: new THREE.MeshStandardMaterial({
          color: 0x856848, // Larch post-and-beam timber trusses
          roughness: 0.72,
          metalness: 0.05,
          side: THREE.DoubleSide
        }),
        layer_roof: new THREE.MeshStandardMaterial({
          color: 0x252932, // Standing-seam architectural milled zinc
          roughness: 0.32,
          metalness: 0.78,
          side: THREE.DoubleSide
        })
      };

      // Assign bespoke physical materials to each layer
      for (const [name, node] of Object.entries(layerNodes)) {
        const mat = architecturalMaterials[name];
        if (mat) {
          node.traverse((child: any) => {
            if (child.isMesh) {
              const layerMat = mat.clone();
              layerMat.clippingPlanes = [clipPlane];
              layerMat.clipShadows = true;
              child.material = layerMat;
              child.userData.baseMaterial = layerMat;
            }
          });
        }
      }

      scene.add(model);
      poster?.classList.add('hidden');

      // Initialize assembled positions (explode = 0)
      updateExplode(0);
      requestRender(3000);
    } catch (err) {
      console.error('Failed to load cottage split layers model:', err);
    }

    // Explode Control (Displaces layers based on layers.json assembled offsets)
    let currentExplode = 0;
    const extraSpreads: { [key: string]: number } = {
      layer_foundation: -0.10,
      layer_floors: -0.04,
      layer_walls_interior: 0.03,
      layer_upper: 0.10,
      layer_truss: 0.18,
      layer_roof: 0.26
    };

    function updateExplode(val: number) {
      currentExplode = val;
      if (!model) return;

      for (const [name, node] of Object.entries(layerNodes)) {
        const assembledY = layerOffsets[name] || 0;
        const spread = extraSpreads[name] || 0;
        // At 0: assembledY. At 1: spread.
        node.position.y = (1 - val) * assembledY + val * spread;
      }

      // Camera dolly back slightly to maintain framing
      camera.position.setLength(1.4 + val * 0.45);
      requestRender();
    }

    explodeRange?.addEventListener('input', (e) => {
      updateExplode(parseFloat((e.target as HTMLInputElement).value));
    });

    btnReset?.addEventListener('click', () => {
      if (explodeRange) explodeRange.value = '0';
      gsap.to({ val: currentExplode }, {
        val: 0,
        duration: 0.8,
        ease: 'power2.out',
        onUpdate: function() { updateExplode(this.targets()[0].val); }
      });
      isolateLayer('all');
      if (isDollhouse) toggleDollhouse();
      if (isSectionCutActive) toggleSectionCut();
      tweenCamera([0.9, 0.6, 1.1], [0, 0, 0]);
    });

    // Layer Isolation Chips
    let activeIsolatedLayer = 'all';
    function isolateLayer(layerId: string) {
      activeIsolatedLayer = layerId;
      layerChips.forEach(c => c.classList.toggle('active', c.dataset.layer === layerId));

      for (const [name, node] of Object.entries(layerNodes)) {
        const isSelected = layerId === 'all' || name === layerId;
        node.traverse((child: any) => {
          if (child.isMesh) {
            if (isSelected) {
              child.material.transparent = false;
              child.material.opacity = 1.0;
              child.material.depthWrite = true;
            } else {
              child.material.transparent = true;
              child.material.opacity = 0.15;
              child.material.depthWrite = false;
            }
          }
        });
      }
      requestRender();
    }

    layerChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const target = chip.dataset.layer || 'all';
        isolateLayer(target);
      });
    });

    // Camera Tweening
    function tweenCamera(pos: [number, number, number], target: [number, number, number]) {
      gsap.to(camera.position, {
        x: pos[0],
        y: pos[1],
        z: pos[2],
        duration: 1.2,
        ease: 'power3.inOut',
        onUpdate: () => requestRender(200)
      });
      gsap.to(controls.target, {
        x: target[0],
        y: target[1],
        z: target[2],
        duration: 1.2,
        ease: 'power3.inOut',
        onUpdate: () => {
          controls.update();
          requestRender(200);
        }
      });
    }

    camButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.preset;
        const preset = studioConfig.cameraPresets.find((p) => p.id === id);
        if (preset) {
          tweenCamera(preset.position, preset.target);
        }
      });
    });

    // Keyboard Shortcuts (1-6)
    window.addEventListener('keydown', (e) => {
      const num = parseInt(e.key);
      if (num >= 1 && num <= studioConfig.cameraPresets.length) {
        const preset = studioConfig.cameraPresets[num - 1];
        if (preset) tweenCamera(preset.position, preset.target);
      }
      if (e.key === 'Escape') {
        if (hotspotModal && !hotspotModal.hasAttribute('hidden')) {
          hotspotModal.setAttribute('hidden', '');
        }
        if (activeIsolatedLayer !== 'all') isolateLayer('all');
      }
    });

    // Dollhouse Mode (Looks down at 55°, fades roof & truss)
    let isDollhouse = false;
    function toggleDollhouse() {
      isDollhouse = !isDollhouse;
      btnDollhouse?.classList.toggle('active', isDollhouse);

      if (isDollhouse) {
        tweenCamera([0.0, 1.1, 0.75], [0, -0.05, 0]);
        // Fade roof and truss
        ['layer_roof', 'layer_truss'].forEach(name => {
          layerNodes[name]?.traverse((c: any) => {
            if (c.isMesh) {
              c.material.transparent = true;
              c.material.opacity = 0.08;
              c.material.depthWrite = false;
            }
          });
        });
      } else {
        tweenCamera([0.9, 0.6, 1.1], [0, 0, 0]);
        isolateLayer(activeIsolatedLayer);
      }
      requestRender();
    }
    btnDollhouse?.addEventListener('click', toggleDollhouse);

    // Section Cut (Animated Y Clipping Plane)
    let isSectionCutActive = false;
    let sectionCutTween: any = null;
    function toggleSectionCut() {
      isSectionCutActive = !isSectionCutActive;
      btnSectionCut?.classList.toggle('active', isSectionCutActive);

      if (sectionCutTween) sectionCutTween.kill();

      if (isSectionCutActive) {
        clipPlane.constant = 0.45;
        sectionCutTween = gsap.to(clipPlane, {
          constant: -0.2,
          duration: 3.5,
          repeat: -1,
          yoyo: true,
          ease: 'power1.inOut',
          onUpdate: () => requestRender(100)
        });
      } else {
        clipPlane.constant = 10.0;
        requestRender();
      }
    }
    btnSectionCut?.addEventListener('click', toggleSectionCut);

    // Hotspots Setup
    hotspotPins.forEach((pin) => {
      pin.addEventListener('click', () => {
        const id = pin.dataset.id;
        const hotspot = studioConfig.hotspots.find((h) => h.id === id);
        if (!hotspot || !hotspotModal) return;

        const imgData = (imagesManifest as any)[hotspot.imageSlug];
        if (hotspotModalImg && imgData) {
          hotspotModalImg.src = `${baseUrl}/images/optimized/${imgData.formats.webp['960'].file}`;
          hotspotModalImg.alt = imgData.alt;
        }

        if (hotspotModalTitle) hotspotModalTitle.textContent = hotspot.name;
        if (hotspotModalDesc) hotspotModalDesc.textContent = hotspot.desc;

        hotspotModal.removeAttribute('hidden');
      });
    });

    btnCloseHotspot?.addEventListener('click', () => {
      hotspotModal?.setAttribute('hidden', '');
    });

    // Touch overlay for mobile
    btnTouch?.addEventListener('click', () => {
      touchOverlay?.classList.add('hidden');
    });

    // Project Hotspot Pins to Screen Space
    const tempVec = new THREE.Vector3();
    function updateHotspots() {
      if (!model) return;
      const widthHalf = canvas.clientWidth / 2;
      const heightHalf = canvas.clientHeight / 2;

      hotspotPins.forEach((pin) => {
        const id = pin.dataset.id;
        const hotspot = studioConfig.hotspots.find((h) => h.id === id);
        if (!hotspot) return;

        tempVec.set(hotspot.position[0], hotspot.position[1], hotspot.position[2]);
        tempVec.project(camera);

        const isBehind = tempVec.z > 1;
        if (isBehind) {
          pin.style.display = 'none';
          return;
        }

        pin.style.display = 'flex';
        const x = tempVec.x * widthHalf + widthHalf;
        const y = -tempVec.y * heightHalf + heightHalf;
        pin.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
      });
    }

    // Render Governor & Resize
    controls.addEventListener('change', () => {
      requestRender();
      updateHotspots();
    });

    const onResize = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      requestRender(500);
      updateHotspots();
    };
    window.addEventListener('resize', onResize);

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      if (controls.update()) {
        requestRender();
      }
      if (isRenderDemandActive) {
        renderer.render(scene, camera);
        updateHotspots();
      }
    }
    animate();
    updateHotspots();
  }

  // IntersectionObserver to warm up / initialize Studio
  const studioObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          loadStudioModule();
          studioObserver.disconnect();
        }
      });
    },
    { rootMargin: '300px 0px' }
  );

  const sectionEl = document.getElementById('chapter-studio');
  if (sectionEl) studioObserver.observe(sectionEl);
</script>

<style>
  .studio-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #0c0e12;
    color: #ffffff;
    padding: 6rem 0 6rem;
  }

  .studio-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header */
  .studio-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  .studio-header-left {
    max-width: 640px;
  }

  .studio-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .studio-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0;
    color: #ffffff;
  }

  .studio-desc {
    max-width: 440px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  /* Viewport */
  .studio-viewport-wrap {
    position: relative;
    width: 100%;
    height: 74vh;
    min-height: 540px;
    max-height: 820px;
    border-radius: 28px;
    overflow: hidden;
    background: radial-gradient(circle at center, #14171d 0%, #0a0b0e 100%);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .studio-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  .studio-canvas:active {
    cursor: grabbing;
  }

  /* Poster */
  .studio-poster {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.5s ease;
  }

  .studio-poster.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .studio-loader-card {
    background: rgba(14, 16, 20, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .loader-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-top-color: var(--accent, #e5a970);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loader-text {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Touch overlay */
  .studio-touch-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 12, 16, 0.6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
