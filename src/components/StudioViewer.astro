---
import { studioConfig } from '../config/studio';
import imagesManifest from '../data/images.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const posterUrl = `${baseUrl}/images/optimized/front-elevation-day-1440.webp`;

const storyModes = [
  { id: 'overview', key: '1', label: 'Overview', desc: 'Front 3/4 perspective of the complete timber & zinc retreat.' },
  { id: 'dollhouse', key: '2', label: 'Dollhouse Interior', desc: 'High-angle view down into the furnished quarters & slate hearth.' },
  { id: 'terrace', key: '3', label: 'Lakeside Terrace', desc: 'Eye-level on the cantilevered cedar deck & lakeside firepit.' },
  { id: 'elevation', key: '4', label: 'Front Elevation', desc: 'Symmetrical front elevation view matching architectural drawings.' }
];

const hotspots = [
  { id: 'living', name: 'Living Pavilion', slug: 'living-fireplace', pos: [-0.05, -0.02, 0.05], desc: 'Built-in Finnish slate hearth and uninterrupted panoramic lake views.' },
  { id: 'kitchen', name: 'Culinary Bay', slug: 'kitchen', pos: [-0.05, -0.02, -0.05], desc: 'Solid oiled Nordic birch cabinetry with cast bronze accents.' },
  { id: 'bedroom', name: 'Primary Suite', slug: 'bedroom', pos: [-0.15, -0.02, -0.10], desc: 'Acoustic timber slat cladding with eastern morning forest orientation.' },
  { id: 'terrace', name: 'Lakeside Deck', slug: 'deck-morning-gold', pos: [0.22, -0.12, 0.0], desc: 'Expansive lakeside cedar deck connecting indoor living with tranquil water.' }
];
---

<section id="chapter-studio" class="studio-section" data-tone="true" data-tone-bg="#0c0e12" data-tone-text="#ffffff">
  <div class="studio-container">
    <!-- Editorial Header -->
    <div class="studio-header">
      <div class="studio-header-left">
        <span class="studio-eyebrow">CHAPTER II · 3D STUDIO</span>
        <h2 class="studio-title sv-reveal-heading">Architectural Scale Model</h2>
      </div>
      <p class="studio-desc">
        Explore the physical scale model of Silvatide Cottage presented on a honed Finnish slate plinth. Orbit freely or select a curated architectural perspective.
      </p>
    </div>

    <!-- 3D Canvas Viewport -->
    <div class="studio-viewport-wrap" id="studioViewportWrap">
      <canvas id="studioCanvas" class="studio-canvas" aria-label="Interactive 3D Architectural Cottage Scale Model"></canvas>

      <!-- Poster / Loading State -->
      <div id="studioPoster" class="studio-poster" style={`background-image: url('${posterUrl}')`}>
        <div class="studio-loader-card">
          <div class="loader-spinner"></div>
          <span class="loader-text">Materializing Architectural Model...</span>
        </div>
      </div>

      <!-- Mobile Tap-to-Interact Overlay -->
      <div id="studioTouchOverlay" class="studio-touch-overlay">
        <button id="btnTouchInteract" class="touch-interact-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          TAP TO EXPLORE 3D MODEL
        </button>
      </div>

      <!-- Hotspot Overlay Pins (projected from 3D) -->
      <div id="studioHotspotsContainer" class="studio-hotspots">
        {hotspots.map((h) => (
          <button class="hotspot-pin" data-id={h.id} data-slug={h.slug} aria-label={`Inspect ${h.name}`}>
            <span class="hotspot-pulse"></span>
            <span class="hotspot-dot"></span>
            <span class="hotspot-label">{h.name}</span>
          </button>
        ))}
      </div>

      <!-- Hotspot Detail Card -->
      <div id="hotspotCard" class="hotspot-modal" hidden>
        <div class="hotspot-modal-inner">
          <button id="btnCloseHotspot" class="modal-close" aria-label="Close card">&times;</button>
          <div class="hotspot-modal-media">
            <img id="hotspotModalImg" src="" alt="" loading="lazy" />
          </div>
          <div class="hotspot-modal-body">
            <span class="hotspot-modal-tag">ARCHITECTURAL IMPRESSION</span>
            <h3 id="hotspotModalTitle" class="hotspot-modal-title"></h3>
            <p id="hotspotModalDesc" class="hotspot-modal-desc"></p>
          </div>
        </div>
      </div>

      <!-- Mode Story Description Badge (Top Right) -->
      <div class="studio-mode-badge" id="studioModeBadge">
        <span class="badge-tag">PERSPECTIVE:</span>
        <span class="badge-title" id="modeBadgeTitle">Overview</span>
        <span class="badge-desc" id="modeBadgeDesc">Front 3/4 perspective of the complete timber & zinc retreat.</span>
      </div>

      <!-- Studio Floating Control Dock -->
      <div class="studio-controls-dock">
        <!-- Curated Modes -->
        <div class="dock-modes-group">
          {storyModes.map((mode, idx) => (
            <button class={`dock-btn ${idx === 0 ? 'active' : ''}`} data-mode={mode.id} title={`${mode.label} (Key ${mode.key})`}>
              <span class="btn-num">{mode.key}</span>
              <span class="btn-label">{mode.label}</span>
            </button>
          ))}
        </div>

        <!-- Roof Cutaway, Turntable & Reset -->
        <div class="dock-actions-group">
          <button id="btnToggleRoof" class="dock-action-btn" title="Toggle Roof Cutaway Lift">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span class="action-label" id="lblRoofAction">ROOF LIFT</span>
          </button>

          <button id="btnAutoRotate" class="dock-action-btn active" title="Toggle Turntable Rotation">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            <span class="action-label">TURNTABLE</span>
          </button>

          <button id="btnResetCamera" class="dock-action-btn" title="Reset Camera View">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="action-label">RESET</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .studio-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #0c0e12;
    color: #ffffff;
    padding: 6rem 0 6rem;
  }

  .studio-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header */
  .studio-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  .studio-header-left {
    max-width: 640px;
  }

  .studio-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .studio-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0;
    color: #ffffff;
  }

  .studio-desc {
    max-width: 440px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  /* Viewport */
  .studio-viewport-wrap {
    position: relative;
    width: 100%;
    height: 76vh;
    min-height: 560px;
    max-height: 840px;
    border-radius: 28px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 45%, #15181f 0%, #090a0d 100%);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .studio-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  .studio-canvas:active {
    cursor: grabbing;
  }

  /* Poster */
  .studio-poster {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.5s ease;
  }

  .studio-poster.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .studio-loader-card {
    background: rgba(14, 16, 20, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .loader-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-top-color: var(--accent, #e5a970);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loader-text {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Touch overlay */
  .studio-touch-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 12, 16, 0.6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 15;
  }

  @media (pointer: coarse) {
    .studio-touch-overlay {
      display: flex;
    }
  }

  .studio-touch-overlay.hidden {
    display: none !important;
  }

  .touch-interact-btn {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    color: #0c0d0e;
    border: none;
    border-radius: 999px;
    padding: 0.9rem 1.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  /* Hotspots */
  .studio-hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .hotspot-pin {
    position: absolute;
    top: 0;
    left: 0;
    background: none;
    border: none;
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem;
  }

  .hotspot-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent, #e5a970);
    border: 2px solid #ffffff;
    box-shadow: 0 0 10px rgba(229, 169, 112, 0.8);
  }

  .hotspot-pulse {
    position: absolute;
    left: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--accent, #e5a970);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% { transform: scale(2); opacity: 0; }
  }

  .hotspot-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #ffffff;
    background: rgba(14, 16, 20, 0.85);
    backdrop-filter: blur(8px);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(4px);
    transition: all 0.2s ease;
  }

  .hotspot-pin:hover .hotspot-label {
    opacity: 1;
    transform: translateX(0);
  }

  /* Hotspot Detail Card */
  .hotspot-modal {
    position: absolute;
    bottom: 5.5rem;
    right: 2rem;
    width: 330px;
    z-index: 30;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hotspot-modal-inner {
    background: rgba(16, 18, 24, 0.92);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
  }

  .hotspot-modal-media img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .hotspot-modal-body {
    padding: 1.25rem;
  }

  .hotspot-modal-tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--accent, #e5a970);
  }

  .hotspot-modal-title {
    font-size: 1.15rem;
    font-weight: 400;
    margin: 0.25rem 0 0.5rem 0;
    color: #ffffff;
  }

  .hotspot-modal-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  /* Mode Story Badge (Top Right) */
  .studio-mode-badge {
    position: absolute;
    top: 1.75rem;
    right: 2rem;
    z-index: 10;
    background: rgba(14, 16, 20, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 0.9rem 1.4rem;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }

  .badge-tag {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .badge-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: #ffffff;
  }

  .badge-desc {
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.65);
  }

  /* Floating Control Dock (Bottom) */
  .studio-controls-dock {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: rgba(14, 16, 20, 0.78);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.5rem 0.75rem 0.5rem 1.25rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
  }

  .dock-modes-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dock-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.75);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .btn-num {
    font-family: monospace;
    font-weight: 700;
    font-size: 0.7rem;
    opacity: 0.5;
  }

  .dock-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .dock-btn.active {
    background: #ffffff;
    color: #0c0d0e;
    border-color: #ffffff;
    font-weight: 600;
  }

  .dock-btn.active .btn-num {
    opacity: 1;
    color: var(--accent, #e5a970);
  }

  .dock-actions-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.75rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .dock-action-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.75);
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    transition: all 0.2s ease;
  }

  .dock-action-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .dock-action-btn.active {
    background: rgba(229, 169, 112, 0.2);
    border-color: var(--accent, #e5a970);
    color: var(--accent, #e5a970);
  }

  @media (max-width: 992px) {
    .studio-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .studio-mode-badge {
      display: none;
    }
    .studio-controls-dock {
      width: 92%;
      overflow-x: auto;
      justify-content: flex-start;
      border-radius: 18px;
      scrollbar-width: none;
    }
    .studio-controls-dock::-webkit-scrollbar {
      display: none;
    }
    .hotspot-modal {
      right: 1.5rem;
      left: 1.5rem;
      width: auto;
      bottom: 6rem;
    }
  }
</style>

<script>
  let isStudioInitialized = false;

  async function loadStudioModule() {
    if (isStudioInitialized) return;
    const canvas = document.getElementById('studioCanvas') as HTMLCanvasElement;
    if (!canvas) return;

    isStudioInitialized = true;

    // Dynamic lazy-load Three.js and dependencies
    const [THREE, { OrbitControls }, { GLTFLoader }, { MeshoptDecoder }, { gsap }] = await Promise.all([
      import('three'),
      import('three/examples/jsm/controls/OrbitControls.js'),
      import('three/examples/jsm/loaders/GLTFLoader.js'),
      import('meshoptimizer'),
      import('gsap')
    ]);

    const poster = document.getElementById('studioPoster');
    const touchOverlay = document.getElementById('studioTouchOverlay');
    const btnTouch = document.getElementById('btnTouchInteract');
    const btnAutoRotate = document.getElementById('btnAutoRotate');
    const btnResetCamera = document.getElementById('btnResetCamera');
    const btnToggleRoof = document.getElementById('btnToggleRoof');
    const lblRoofAction = document.getElementById('lblRoofAction');
    const dockButtons = document.querySelectorAll<HTMLButtonElement>('.dock-btn');
    const modeTitle = document.getElementById('modeBadgeTitle');
    const modeDesc = document.getElementById('modeBadgeDesc');
    const hotspotPins = document.querySelectorAll<HTMLButtonElement>('.hotspot-pin');
    const hotspotModal = document.getElementById('hotspotCard');
    const hotspotModalImg = document.getElementById('hotspotModalImg') as HTMLImageElement;
    const hotspotModalTitle = document.getElementById('hotspotModalTitle');
    const hotspotModalDesc = document.getElementById('hotspotModalDesc');
    const btnCloseHotspot = document.getElementById('btnCloseHotspot');

    const baseUrl = (import.meta as any).env.BASE_URL.replace(/\/$/, '');

    // Setup High-End WebGL Renderer
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      powerPreference: 'high-performance',
      alpha: true
    });

    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();

    // Camera & Constrained Orbit Controls (Zero underbelly viewing!)
    const camera = new THREE.PerspectiveCamera(40, canvas.clientWidth / canvas.clientHeight, 0.05, 50);
    camera.position.set(1.15, 0.65, 1.25);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.maxPolarAngle = Math.PI / 2 - 0.08; // 85 max angle: prevents camera flipping underneath!
    controls.minPolarAngle = Math.PI / 6;         // 30 min angle
    controls.minDistance = 0.8;
    controls.maxDistance = 2.8;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.5;
    controls.target.set(0, -0.05, 0);

    // Nordic Studio Key & Rim Lighting (Bright, Crisp Daylight)
    const hemiLight = new THREE.HemisphereLight(0xfffdfa, 0x2a3038, 1.8);
    scene.add(hemiLight);

    const keySun = new THREE.DirectionalLight(0xffeedd, 2.8);
    keySun.position.set(5, 7, 4);
    scene.add(keySun);

    const coolRim = new THREE.DirectionalLight(0x78a0d0, 1.4);
    coolRim.position.set(-5, 4, -4);
    scene.add(coolRim);

    const groundBounce = new THREE.DirectionalLight(0x443224, 0.6);
    groundBounce.position.set(0, -3, 0);
    scene.add(groundBounce);

    // Architectural Gallery Slate Pedestal
    const pedestalGeo = new THREE.CylinderGeometry(1.4, 1.45, 0.04, 64);
    const pedestalMat = new THREE.MeshStandardMaterial({
      color: 0x14161a,
      roughness: 0.85,
      metalness: 0.15
    });
    const pedestal = new THREE.Mesh(pedestalGeo, pedestalMat);
    pedestal.position.y = -0.32;
    scene.add(pedestal);

    // Subtle Gold Hairline Perimeter Ring
    const ringGeo = new THREE.RingGeometry(1.36, 1.38, 64);
    const ringMat = new THREE.MeshBasicMaterial({
      color: 0xe5a970,
      transparent: true,
      opacity: 0.35,
      side: THREE.DoubleSide
    });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.x = -Math.PI / 2;
    ring.position.y = -0.299;
    scene.add(ring);

    // Contact Shadow Plane
    const shadowGeo = new THREE.PlaneGeometry(2.4, 2.4);
    const shadowMat = new THREE.MeshBasicMaterial({
      color: 0x050608,
      transparent: true,
      opacity: 0.55,
      depthWrite: false
    });
    const shadow = new THREE.Mesh(shadowGeo, shadowMat);
    shadow.rotation.x = -Math.PI / 2;
    shadow.position.y = -0.298;
    scene.add(shadow);

    // Load Clean Assembled Model with Full Colors & Textures
    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);

    let model: any = null;
    let truss: any = null;
    let roof: any = null;
    let isRoofLifted = false;
    let isRenderDemandActive = true;
    let renderDemandTimer = 0;

    const trussRestY = -0.052;
    const roofRestY = -0.108;

    function requestRender(durationMs = 1500) {
      isRenderDemandActive = true;
      clearTimeout(renderDemandTimer);
      renderDemandTimer = window.setTimeout(() => {
        isRenderDemandActive = false;
      }, durationMs);
    }

    function setRoofLift(lifted: boolean) {
      isRoofLifted = lifted;
      btnToggleRoof?.classList.toggle('active', lifted);
      if (lblRoofAction) {
        lblRoofAction.textContent = lifted ? 'ROOF LOWER' : 'ROOF LIFT';
      }

      if (roof) {
        gsap.to(roof.position, {
          y: lifted ? roofRestY + 0.35 : roofRestY,
          duration: 1.1,
          ease: 'power2.inOut',
          onUpdate: () => requestRender(200)
        });
        roof.traverse((c: any) => {
          if (c.isMesh && c.material) {
            c.material.transparent = true;
            gsap.to(c.material, {
              opacity: lifted ? 0.0 : 1.0,
              duration: 0.85,
              ease: 'power2.inOut'
            });
          }
        });
      }
      if (truss) {
        gsap.to(truss.position, {
          y: lifted ? trussRestY + 0.22 : trussRestY,
          duration: 1.1,
          ease: 'power2.inOut',
          onUpdate: () => requestRender(200)
        });
        truss.traverse((c: any) => {
          if (c.isMesh && c.material) {
            c.material.transparent = true;
            gsap.to(c.material, {
              opacity: lifted ? 0.0 : 1.0,
              duration: 0.85,
              ease: 'power2.inOut'
            });
          }
        });
      }
    }

    try {
      const gltf = await loader.loadAsync(`${baseUrl}/models/cottage-assembled.glb`);
      model = gltf.scene;

      truss = model.getObjectByName('cottage_truss');
      roof = model.getObjectByName('cottage_roof');

      if (truss) {
        truss.position.y += trussRestY;
        truss.traverse((c: any) => {
          if (c.isMesh && c.material) {
            c.material = c.material.clone();
          }
        });
      }
      if (roof) {
        roof.position.y += roofRestY;
        roof.traverse((c: any) => {
          if (c.isMesh && c.material) {
            c.material = c.material.clone();
          }
        });
      }

      // Center model
      const box = new THREE.Box3().setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);

      const targetScale = 1.25 / maxDim;
      model.scale.setScalar(targetScale);
      model.position.sub(center.multiplyScalar(targetScale));
      // Ground exactly on top of pedestal
      model.position.y += (size.y * targetScale) / 2 - 0.28;

      // Preserve authentic full-color PBR materials (Blonde Pine, Zinc, Glass, Oiled Cedar)
      model.traverse((child: any) => {
        if (child.isMesh && child.material) {
          child.material.side = THREE.DoubleSide;
          child.material.toneMapped = true;
          // Ensure base color is pure white so diffuse texture maps display with 100% color accuracy
          if (child.material.color) {
            child.material.color.setHex(0xffffff);
          }
          if (child.material.map) {
            child.material.map.colorSpace = THREE.SRGBColorSpace;
            child.material.map.needsUpdate = true;
          }
          child.material.roughness = 0.65;
          child.material.metalness = 0.12;
          child.material.needsUpdate = true;
        }
      });

      scene.add(model);
      poster?.classList.add('hidden');
      requestRender(3500);
    } catch (err) {
      console.error('Failed to load cottage-assembled model:', err);
    }

    // Storytelling Camera Presets
    const presets: { [key: string]: { pos: [number, number, number]; target: [number, number, number]; title: string; desc: string; liftRoof?: boolean } } = {
      overview: {
        pos: [1.15, 0.65, 1.25],
        target: [0, -0.05, 0],
        title: 'Overview',
        desc: 'Front 3/4 perspective of the complete timber & zinc retreat.',
        liftRoof: false
      },
      dollhouse: {
        pos: [-0.10, 1.45, 0.55],
        target: [-0.05, -0.1, 0.0],
        title: 'Dollhouse Interior',
        desc: 'Elevated view down into the furnished quarters & slate hearth.',
        liftRoof: true
      },
      terrace: {
        pos: [1.15, 0.28, -0.25],
        target: [0.25, -0.1, 0.0],
        title: 'Lakeside Terrace',
        desc: 'Eye-level on the cantilevered cedar deck & lakeside firepit.',
        liftRoof: false
      },
      elevation: {
        pos: [0.0, 0.2, 1.6],
        target: [0, -0.05, 0],
        title: 'Front Elevation',
        desc: 'Symmetrical front elevation view matching architectural drawings.',
        liftRoof: false
      }
    };

    function tweenCamera(pos: [number, number, number], target: [number, number, number]) {
      controls.autoRotate = false;
      btnAutoRotate?.classList.remove('active');

      gsap.to(camera.position, {
        x: pos[0],
        y: pos[1],
        z: pos[2],
        duration: 1.3,
        ease: 'power3.inOut',
        onUpdate: () => requestRender(200)
      });
      gsap.to(controls.target, {
        x: target[0],
        y: target[1],
        z: target[2],
        duration: 1.3,
        ease: 'power3.inOut',
        onUpdate: () => {
          controls.update();
          requestRender(200);
        }
      });
    }

    // Dock Buttons
    dockButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode;
        if (!mode || !presets[mode]) return;

        dockButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const p = presets[mode];
        if (modeTitle) modeTitle.textContent = p.title;
        if (modeDesc) modeDesc.textContent = p.desc;

        setRoofLift(!!p.liftRoof);
        tweenCamera(p.pos, p.target);
      });
    });

    // Roof Lift Toggle Button
    btnToggleRoof?.addEventListener('click', () => {
      setRoofLift(!isRoofLifted);
    });

    // Auto-Rotate Turntable Toggle
    btnAutoRotate?.addEventListener('click', () => {
      controls.autoRotate = !controls.autoRotate;
      btnAutoRotate.classList.toggle('active', controls.autoRotate);
      requestRender(3000);
    });

    // Reset Camera Button
    btnResetCamera?.addEventListener('click', () => {
      dockButtons.forEach((b, i) => b.classList.toggle('active', i === 0));
      const p = presets.overview;
      if (modeTitle) modeTitle.textContent = p.title;
      if (modeDesc) modeDesc.textContent = p.desc;
      setRoofLift(false);
      tweenCamera(p.pos, p.target);
      controls.autoRotate = true;
      btnAutoRotate?.classList.add('active');
    });

    // Keyboard Shortcuts (1-4)
    window.addEventListener('keydown', (e) => {
      const modeKeys = ['overview', 'dollhouse', 'terrace', 'elevation'];
      const num = parseInt(e.key);
      if (num >= 1 && num <= 4) {
        const mode = modeKeys[num - 1];
        const btn = document.querySelector(`.dock-btn[data-mode="${mode}"]`) as HTMLButtonElement;
        btn?.click();
      }
      if (e.key === 'Escape') {
        hotspotModal?.setAttribute('hidden', '');
      }
    });

    // Hotspots Setup
    hotspotPins.forEach((pin) => {
      pin.addEventListener('click', () => {
        const id = pin.dataset.id;
        const hotspot = [
          { id: 'living', name: 'Living Pavilion', slug: 'living-fireplace', pos: [-0.05, -0.02, 0.05], desc: 'Built-in Finnish slate hearth and uninterrupted panoramic lake views.' },
          { id: 'kitchen', name: 'Culinary Bay', slug: 'kitchen', pos: [-0.05, -0.02, -0.05], desc: 'Solid oiled Nordic birch cabinetry with cast bronze accents.' },
          { id: 'bedroom', name: 'Primary Suite', slug: 'bedroom', pos: [-0.15, -0.02, -0.10], desc: 'Acoustic timber slat cladding with eastern morning forest orientation.' },
          { id: 'terrace', name: 'Lakeside Deck', slug: 'deck-morning-gold', pos: [0.22, -0.12, 0.0], desc: 'Expansive lakeside cedar deck connecting indoor living with tranquil water.' }
        ].find((h) => h.id === id);

        if (!hotspot || !hotspotModal) return;

        const imgData = (imagesManifest as any)[hotspot.slug];
        if (hotspotModalImg && imgData) {
          hotspotModalImg.src = `${baseUrl}/images/optimized/${imgData.formats.webp['960'].file}`;
          hotspotModalImg.alt = imgData.alt;
        }

        if (hotspotModalTitle) hotspotModalTitle.textContent = hotspot.name;
        if (hotspotModalDesc) hotspotModalDesc.textContent = hotspot.desc;

        hotspotModal.removeAttribute('hidden');

        // Focus camera slightly toward the hotspot
        tweenCamera([hotspot.pos[0] * 1.5 + 0.6, hotspot.pos[1] + 0.3, hotspot.pos[2] * 1.5 + 0.6], [hotspot.pos[0], hotspot.pos[1], hotspot.pos[2]]);
      });
    });

    btnCloseHotspot?.addEventListener('click', () => {
      hotspotModal?.setAttribute('hidden', '');
    });

    btnTouch?.addEventListener('click', () => {
      touchOverlay?.classList.add('hidden');
    });

    // Project Hotspot Pins
    const tempVec = new THREE.Vector3();
    const hotspotCoords: { [key: string]: [number, number, number] } = {
      living: [-0.05, -0.02, 0.05],
      kitchen: [-0.05, -0.02, -0.05],
      bedroom: [-0.15, -0.02, -0.10],
      terrace: [0.22, -0.12, 0.0]
    };

    function updateHotspots() {
      if (!model) return;
      const widthHalf = canvas.clientWidth / 2;
      const heightHalf = canvas.clientHeight / 2;

      hotspotPins.forEach((pin) => {
        const id = pin.dataset.id;
        const coords = id ? hotspotCoords[id] : null;
        if (!coords) return;

        tempVec.set(coords[0], coords[1], coords[2]);
        tempVec.project(camera);

        const isBehind = tempVec.z > 1;
        if (isBehind) {
          pin.style.display = 'none';
          return;
        }

        pin.style.display = 'flex';
        const x = tempVec.x * widthHalf + widthHalf;
        const y = -tempVec.y * heightHalf + heightHalf;
        pin.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
      });
    }

    // Auto-Resume Turntable after user idle
    let userIdleTimeout: any = null;
    controls.addEventListener('start', () => {
      clearTimeout(userIdleTimeout);
      controls.autoRotate = false;
      btnAutoRotate?.classList.remove('active');
    });

    controls.addEventListener('end', () => {
      clearTimeout(userIdleTimeout);
      userIdleTimeout = setTimeout(() => {
        controls.autoRotate = true;
        btnAutoRotate?.classList.add('active');
        requestRender(5000);
      }, 4000);
    });

    controls.addEventListener('change', () => {
      requestRender();
      updateHotspots();
    });

    const onResize = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      requestRender(500);
      updateHotspots();
    };
    window.addEventListener('resize', onResize);

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      if (controls.update() || controls.autoRotate) {
        requestRender();
      }
      if (isRenderDemandActive) {
        renderer.render(scene, camera);
        updateHotspots();
      }
    }
    animate();
    updateHotspots();
  }

  // IntersectionObserver to warm up / initialize Studio
  const studioObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          loadStudioModule();
          studioObserver.disconnect();
        }
      });
    },
    { rootMargin: '300px 0px' }
  );

  const sectionEl = document.getElementById('chapter-studio');
  if (sectionEl) studioObserver.observe(sectionEl);
</script>
