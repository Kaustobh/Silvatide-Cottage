---
import imagesManifest from '../data/images.json';
import { modelsConfig } from '../config/models';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Interlude image (Photo 6)
const interludeImg = imagesManifest['fog-shore-corner'];

// 4 Rooms (13 living, 12 kitchen, 8 bedroom, 9 bathroom)
const rooms = [
  {
    num: '01',
    slug: 'living-fireplace',
    name: 'Living Pavilion',
    role: 'Gathering & Hearth',
    desc: 'Built-in Finnish slate hearth, low linen seating, and floor-to-ceiling glass framing the open lake.',
    img: imagesManifest['living-fireplace'],
    model: modelsConfig.interiors.living,
    has3D: true
  },
  {
    num: '02',
    slug: 'kitchen',
    name: 'Culinary Bay',
    role: 'Culinary & Dining',
    desc: 'Solid oiled Nordic birch cabinetry, cast bronze hardware, and uninterrupted water views during morning prep.',
    img: imagesManifest['kitchen'],
    model: null,
    has3D: false
  },
  {
    num: '03',
    slug: 'bedroom',
    name: 'Primary Suite',
    role: 'Rest & Solitude',
    desc: 'Acoustic timber slat cladding, linen bedding, and eastern dawn orientation filtered through pine canopies.',
    img: imagesManifest['bedroom'],
    model: modelsConfig.interiors.bedroom,
    has3D: true
  },
  {
    num: '04',
    slug: 'bathroom',
    name: 'Forest Bath',
    role: 'Ritual & Warmth',
    desc: 'Honed riverbed stone, frameless rain shower, illuminated circular mirror, and diffuse skylight.',
    img: imagesManifest['bathroom'],
    model: modelsConfig.interiors.bathroom,
    has3D: true
  }
];
---

<!-- ==========================================
     INTERLUDE: Full-bleed parallax pause
     ========================================== -->
<section id="chapter-interlude" class="interlude-section" data-tone="true" data-tone-bg="#0a0c0e" data-tone-text="#ffffff">
  <div class="interlude-bg-wrap">
    <picture>
      <source srcset={`${baseUrl}/images/optimized/fog-shore-corner-2200.avif 2200w, ${baseUrl}/images/optimized/fog-shore-corner-1440.avif 1440w, ${baseUrl}/images/optimized/fog-shore-corner-960.avif 960w`} type="image/avif" />
      <source srcset={`${baseUrl}/images/optimized/fog-shore-corner-2200.webp 2200w, ${baseUrl}/images/optimized/fog-shore-corner-1440.webp 1440w, ${baseUrl}/images/optimized/fog-shore-corner-960.webp 960w`} type="image/webp" />
      <img
        src={`${baseUrl}/images/optimized/fog-shore-corner-1440.webp`}
        alt={interludeImg.alt}
        class="interlude-bg"
        id="interludeBg"
        loading="lazy"
      />
    </picture>
    <div class="interlude-overlay"></div>
  </div>

  <div class="interlude-content container">
    <span class="interlude-coord">61° 29' 48" N · 28° 14' 12" E</span>
    <blockquote class="interlude-quote sv-reveal-heading">
      “Silence carved into the Finnish wilderness.”
    </blockquote>
    <span class="interlude-sub">SILVATIDE RETREAT · ARCHIPELAGO SAIMAA</span>
  </div>
</section>

<!-- ==========================================
     CHAPTER III: INSIDE (Horizontal Track)
     ========================================== -->
<section id="chapter-inside" class="inside-section" data-tone="true" data-tone-bg="#101114" data-tone-text="#f5f5f7">
  <!-- Pinned track wrapper for desktop -->
  <div class="inside-pin-wrap" id="insidePinWrap">
    <!-- Header panel on track left -->
    <div class="inside-intro-panel">
      <span class="inside-eyebrow">CHAPTER III · INSIDE</span>
      <h2 class="inside-title sv-reveal-heading">Atmospheric Living Quarters</h2>
      <p class="inside-desc">
        Four micro-environments shaped by Finnish pine, honed stone, and changing natural daylight. Explore each space or inspect in 3D.
      </p>
      <div class="inside-scroll-hint">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <span>SCROLL HORIZONTALLY</span>
      </div>
    </div>

    <!-- Rooms Track -->
    <div class="inside-track" id="insideTrack">
      {rooms.map((room) => (
        <article class="room-card" data-slug={room.slug} data-has-3d={room.has3D ? 'true' : 'false'}>
          <div class="room-frame">
            <div class="room-img-wrap">
              <picture>
                <source srcset={`${baseUrl}/images/optimized/${room.slug}-1440.avif 1440w, ${baseUrl}/images/optimized/${room.slug}-960.avif 960w`} type="image/avif" />
                <source srcset={`${baseUrl}/images/optimized/${room.slug}-1440.webp 1440w, ${baseUrl}/images/optimized/${room.slug}-960.webp 960w`} type="image/webp" />
                <img
                  src={`${baseUrl}/images/optimized/${room.slug}-960.webp`}
                  alt={room.img.alt}
                  class="room-photo"
                  loading="lazy"
                />
              </picture>
              <div class="room-scrim"></div>
            </div>

            <!-- Header inside frame -->
            <div class="room-card-header">
              <span class="room-tick">{room.num} / 04</span>
              <span class="room-role">{room.role}</span>
            </div>

            <!-- Footer / details inside frame -->
            <div class="room-card-footer">
              <div class="room-text">
                <h3 class="room-name">{room.name}</h3>
                <p class="room-desc">{room.desc}</p>
              </div>

              {room.has3D && (
                <button
                  class="btn-inspect-3d"
                  data-model={room.model}
                  data-room-name={room.name}
                  aria-label={`Inspect ${room.name} in 3D`}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                  <span>3D ROOM</span>
                </button>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Dedicated 3D Room Inspection Modal -->
  <div id="room3dModal" class="room-3d-modal" hidden>
    <div class="room-3d-backdrop" id="room3dBackdrop"></div>
    <div class="room-3d-dialog">
      <div class="room-3d-header">
        <div class="room-3d-info">
          <span class="room-3d-badge">3D SPATIAL MODEL</span>
          <h4 id="room3dTitle" class="room-3d-title">Living Pavilion</h4>
        </div>
        <button id="room3dClose" class="room-3d-close" aria-label="Close 3D Viewer">&times;</button>
      </div>

      <div class="room-3d-viewport">
        <canvas id="room3dCanvas" class="room-3d-canvas"></canvas>
        <div id="room3dSpinner" class="room-3d-spinner">
          <div class="spinner-ring"></div>
          <span>Loading Spatial Room Geometry...</span>
        </div>
      </div>

      <div class="room-3d-footer">
        <span class="room-3d-hint">Drag to orbit · Pinch or scroll to zoom · Double-click to reset</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     INTERLUDE STYLES
     ============================================================ */
  .interlude-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0a0c0e;
  }

  .interlude-bg-wrap {
    position: absolute;
    inset: -10% 0 -10% 0; /* Extra overflow for parallax */
    width: 100%;
    height: 120%;
    z-index: 1;
  }

  .interlude-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.08);
    will-change: transform;
  }

  .interlude-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(10, 12, 14, 0.45) 0%, rgba(10, 12, 14, 0.85) 100%);
  }

  .interlude-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .interlude-coord {
    font-family: monospace;
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }

  .interlude-quote {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.25;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
  }

  .interlude-sub {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
  }

  /* ============================================================
     CHAPTER III: INSIDE HORIZONTAL TRACK
     ============================================================ */
  .inside-section {
    position: relative;
    width: 100%;
    background: #101114;
    color: #f5f5f7;
    overflow: hidden;
  }

  .inside-pin-wrap {
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .inside-intro-panel {
    flex-shrink: 0;
    width: 38vw;
    min-width: 340px;
    max-width: 500px;
    padding: 0 4rem 0 5vw;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    z-index: 2;
  }

  .inside-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .inside-title {
    font-size: clamp(2.2rem, 3.5vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
    color: #ffffff;
  }

  .inside-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .inside-scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 1rem;
    animation: pulseHint 2s infinite ease-in-out;
  }

  @keyframes pulseHint {
    0%, 100% { opacity: 0.45; transform: translateX(0); }
    50% { opacity: 0.85; transform: translateX(6px); }
  }

  .inside-track {
    display: flex;
    gap: 2.5rem;
    padding-right: 8vw;
    will-change: transform;
  }

  .room-card {
    flex-shrink: 0;
    width: 56vw;
    max-width: 820px;
    height: 72vh;
    min-height: 480px;
    max-height: 700px;
    position: relative;
  }

  .room-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #18191d;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s ease, transform 0.4s ease;
  }

  .room-frame:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .room-img-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .room-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    transition: transform 0.8s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .room-frame:hover .room-photo {
    transform: scale(1.1);
  }

  .room-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(16, 17, 20, 0.55) 0%,
      rgba(16, 17, 20, 0.1) 40%,
      rgba(16, 17, 20, 0.85) 90%,
      rgba(16, 17, 20, 0.95) 100%
    );
    z-index: 2;
  }

  .room-card-header {
    position: relative;
    z-index: 3;
    padding: 2rem 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .room-tick {
    font-family: monospace;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.5);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .room-role {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
  }

  .room-card-footer {
    position: relative;
    z-index: 3;
    padding: 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .room-text {
    max-width: 520px;
  }

  .room-name {
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .room-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .btn-inspect-3d {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .btn-inspect-3d:hover {
    background: #ffffff;
    color: #0c0d0e;
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  /* ============================================================
     3D ROOM INSPECTION MODAL
     ============================================================ */
  .room-3d-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .room-3d-modal.active {
    opacity: 1;
    pointer-events: auto;
  }

  .room-3d-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 11, 14, 0.88);
    backdrop-filter: blur(16px);
  }

  .room-3d-dialog {
    position: relative;
    z-index: 2;
    width: 90vw;
    max-width: 1040px;
    height: 82vh;
    background: #14161a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
  }

  .room-3d-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .room-3d-badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--accent, #e5a970);
  }

  .room-3d-title {
    font-size: 1.35rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0.2rem 0 0 0;
  }

  .room-3d-close {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    transition: color 0.2s ease;
  }

  .room-3d-close:hover {
    color: #ffffff;
  }

  .room-3d-viewport {
    position: relative;
    flex: 1;
    width: 100%;
    min-height: 0;
    background: radial-gradient(circle at center, #1a1c22 0%, #0d0e12 100%);
  }

  .room-3d-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  .room-3d-canvas:active {
    cursor: grabbing;
  }

  .room-3d-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: #14161a;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    z-index: 3;
    transition: opacity 0.3s ease;
  }

  .spinner-ring {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--accent, #e5a970);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .room-3d-footer {
    padding: 0.85rem 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: center;
    background: #111216;
  }

  .room-3d-hint {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.45);
  }

  /* ============================================================
     RESPONSIVE OVERRIDES (MOBILE STACKED CARDS)
     ============================================================ */
  @media (max-width: 992px) {
    .inside-pin-wrap {
      height: auto;
      flex-direction: column;
      overflow: visible;
      padding: 5rem 1.5rem 6rem;
    }

    .inside-intro-panel {
      width: 100%;
      min-width: 0;
      max-width: 100%;
      padding: 0 0 3rem 0;
    }

    .inside-scroll-hint {
      display: none;
    }

    .inside-track {
      flex-direction: column;
      gap: 3rem;
      padding-right: 0;
      width: 100%;
      transform: none !important;
    }

    .room-card {
      width: 100%;
      max-width: 100%;
      height: 60vh;
      min-height: 400px;
    }

    .room-card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.5rem;
    }

    .room-card-header {
      padding: 1.5rem;
    }

    .room-3d-dialog {
      width: 95vw;
      height: 75vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interlude-bg,
    .inside-track,
    .room-photo {
      transform: none !important;
      transition: none !important;
    }
    .inside-pin-wrap {
      height: auto;
      flex-direction: column;
    }
    .inside-track {
      flex-direction: column;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initInsideExperience() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 993px)').matches;

    // 1. Interlude Parallax
    const interludeSection = document.getElementById('chapter-interlude');
    const interludeBg = document.getElementById('interludeBg');
    if (interludeSection && interludeBg && !prefersReducedMotion) {
      gsap.fromTo(
        interludeBg,
        { yPercent: -10 },
        {
          yPercent: 10,
          ease: 'none',
          scrollTrigger: {
            trigger: interludeSection,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true
          }
        }
      );
    }

    // 2. Desktop Horizontal Pin Track
    const insidePinWrap = document.getElementById('insidePinWrap');
    const insideTrack = document.getElementById('insideTrack');
    const insideSection = document.getElementById('chapter-inside');

    if (isDesktop && !prefersReducedMotion && insidePinWrap && insideTrack && insideSection) {
      const getScrollAmount = () => {
        const trackWidth = insideTrack.scrollWidth;
        const viewportWidth = window.innerWidth;
        const introWidth = document.querySelector('.inside-intro-panel')?.getBoundingClientRect().width || 400;
        return -(trackWidth - (viewportWidth - introWidth) + 120);
      };

      const horizontalScroll = gsap.to(insideTrack, {
        x: () => getScrollAmount(),
        ease: 'none',
        scrollTrigger: {
          trigger: insideSection,
          pin: true,
          scrub: 0.8,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          start: 'top top',
          end: () => `+=${insideTrack.scrollWidth - window.innerWidth + 500}`
        }
      });

      // Subtle inner parallax on photos
      const photos = insideTrack.querySelectorAll('.room-photo');
      photos.forEach((photo) => {
        gsap.fromTo(
          photo,
          { xPercent: 5 },
          {
            xPercent: -5,
            ease: 'none',
            scrollTrigger: {
              trigger: photo.closest('.room-card'),
              containerAnimation: horizontalScroll,
              start: 'left right',
              end: 'right left',
              scrub: true
            }
          }
        );
      });
    }

    // 3. 3D Room Viewer Modal Controller
    setupRoom3DViewer();
  }

  let roomViewerLoaded = false;
  let activeScene: any = null;
  let activeCamera: any = null;
  let activeRenderer: any = null;
  let activeControls: any = null;
  let animFrameId: number | null = null;

  function setupRoom3DViewer() {
    const modal = document.getElementById('room3dModal');
    const backdrop = document.getElementById('room3dBackdrop');
    const closeBtn = document.getElementById('room3dClose');
    const titleEl = document.getElementById('room3dTitle');
    const spinner = document.getElementById('room3dSpinner');
    const canvas = document.getElementById('room3dCanvas') as HTMLCanvasElement;
    const inspectBtns = document.querySelectorAll('.btn-inspect-3d');

    if (!modal || !canvas) return;

    const closeModal = () => {
      modal.classList.remove('active');
      modal.setAttribute('hidden', '');
      if (animFrameId) {
        cancelAnimationFrame(animFrameId);
        animFrameId = null;
      }
    };

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });

    inspectBtns.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const modelUrl = (btn as HTMLElement).dataset.model;
        const roomName = (btn as HTMLElement).dataset.roomName || 'Spatial Room';

        if (!modelUrl) return;

        if (titleEl) titleEl.textContent = roomName;
        modal.removeAttribute('hidden');
        modal.classList.add('active');
        if (spinner) spinner.style.opacity = '1';

        // Lazy load Three.js & render room
        await renderRoomModel(canvas, modelUrl, spinner);
      });
    });
  }

  async function renderRoomModel(canvas: HTMLCanvasElement, modelUrl: string, spinner: HTMLElement | null) {
    const THREE = await import('three');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
    const { MeshoptDecoder } = await import('three/examples/jsm/libs/meshopt_decoder.module.js');

    const container = canvas.parentElement;
    if (!container) return;

    const width = container.clientWidth;
    const height = container.clientHeight;

    // Renderer
    if (!activeRenderer) {
      activeRenderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: false,
        powerPreference: 'high-performance'
      });
      activeRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      activeRenderer.toneMapping = THREE.ACESFilmicToneMapping;
      activeRenderer.toneMappingExposure = 1.15;
      activeRenderer.outputColorSpace = THREE.SRGBColorSpace;
    }
    activeRenderer.setSize(width, height);

    // Scene
    activeScene = new THREE.Scene();
    activeScene.background = new THREE.Color(0x121317);

    // Camera
    activeCamera = new THREE.PerspectiveCamera(40, width / height, 0.05, 50);
    activeCamera.position.set(0.6, 0.45, 0.6);

    // Controls
    if (activeControls) activeControls.dispose();
    activeControls = new OrbitControls(activeCamera, canvas);
    activeControls.enableDamping = true;
    activeControls.dampingFactor = 0.05;
    activeControls.maxPolarAngle = Math.PI / 2 + 0.05;
    activeControls.minDistance = 0.2;
    activeControls.maxDistance = 2.5;

    // Lighting
    const hemiLight = new THREE.HemisphereLight(0xfff8ee, 0x1a1c24, 1.4);
    activeScene.add(hemiLight);

    const dirLight = new THREE.DirectionalLight(0xffeedd, 2.0);
    dirLight.position.set(2, 4, 3);
    activeScene.add(dirLight);

    const softFill = new THREE.DirectionalLight(0x90a4ae, 0.8);
    softFill.position.set(-2, 1, -2);
    activeScene.add(softFill);

    // Grid Floor Accent
    const grid = new THREE.GridHelper(2, 20, 0x333742, 0x20222a);
    grid.position.y = -0.01;
    activeScene.add(grid);

    // GLTFLoader
    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);

    loader.load(
      modelUrl,
      (gltf) => {
        const model = gltf.scene;

        // Center model
        const box = new THREE.Box3().setFromObject(model);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z);

        // Normalize scale
        const targetScale = 0.8 / maxDim;
        model.scale.setScalar(targetScale);
        model.position.sub(center.multiplyScalar(targetScale));
        model.position.y += (size.y * targetScale) / 2;

        activeScene.add(model);
        activeControls.target.set(0, (size.y * targetScale) / 2, 0);
        activeControls.update();

        if (spinner) spinner.style.opacity = '0';
      },
      undefined,
      (err) => {
        console.error('Failed to load room model:', err);
        if (spinner) spinner.innerHTML = '<span style="color:#e06666">Failed to load room geometry.</span>';
      }
    );

    // Resize handler
    const handleResize = () => {
      if (!container || !activeRenderer || !activeCamera) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      activeCamera.aspect = w / h;
      activeCamera.updateProjectionMatrix();
      activeRenderer.setSize(w, h);
    };
    window.addEventListener('resize', handleResize);

    // Animation Loop
    const animate = () => {
      animFrameId = requestAnimationFrame(animate);
      if (activeControls) activeControls.update();
      if (activeRenderer && activeScene && activeCamera) {
        activeRenderer.render(activeScene, activeCamera);
      }
    };
    animate();
  }

  // Initialize on DOM load or Astro transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInsideExperience);
  } else {
    initInsideExperience();
  }

  document.addEventListener('astro:page-load', initInsideExperience);
</script>
