---
import imagesManifest from '../data/images.json';
import { modelsConfig } from '../config/models';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Interlude image (Photo 6)
const interludeImg = imagesManifest['fog-shore-corner'];

// 4 Rooms (13 living, 12 kitchen, 8 bedroom, 9 bathroom)
const rooms = [
  {
    num: '01',
    slug: 'living-fireplace',
    name: 'Living Pavilion',
    role: 'Gathering & Hearth',
    desc: 'Built-in Finnish slate hearth, low linen seating, and floor-to-ceiling glass framing the open lake.',
    img: imagesManifest['living-fireplace'],
    model: modelsConfig.interiors.living,
    has3D: true
  },
  {
    num: '02',
    slug: 'kitchen',
    name: 'Culinary Bay',
    role: 'Culinary & Dining',
    desc: 'Solid oiled Nordic birch cabinetry, cast bronze hardware, and uninterrupted water views during morning prep.',
    img: imagesManifest['kitchen'],
    model: null,
    has3D: false
  },
  {
    num: '03',
    slug: 'bedroom',
    name: 'Primary Suite',
    role: 'Rest & Solitude',
    desc: 'Acoustic timber slat cladding, linen bedding, and eastern dawn orientation filtered through pine canopies.',
    img: imagesManifest['bedroom'],
    model: modelsConfig.interiors.bedroom,
    has3D: true
  },
  {
    num: '04',
    slug: 'bathroom',
    name: 'Forest Bath',
    role: 'Ritual & Warmth',
    desc: 'Honed riverbed stone, frameless rain shower, illuminated circular mirror, and diffuse skylight.',
    img: imagesManifest['bathroom'],
    model: modelsConfig.interiors.bathroom,
    has3D: true
  }
];
---

<!-- ==========================================
     INTERLUDE: Full-bleed parallax pause
     ========================================== -->
<section id="chapter-interlude" class="interlude-section" data-tone="true" data-tone-bg="#0a0c0e" data-tone-text="#ffffff">
  <div class="interlude-bg-wrap">
    <picture>
      <source srcset={`${baseUrl}/images/optimized/fog-shore-corner-2200.avif 2200w, ${baseUrl}/images/optimized/fog-shore-corner-1440.avif 1440w, ${baseUrl}/images/optimized/fog-shore-corner-960.avif 960w`} type="image/avif" />
      <source srcset={`${baseUrl}/images/optimized/fog-shore-corner-2200.webp 2200w, ${baseUrl}/images/optimized/fog-shore-corner-1440.webp 1440w, ${baseUrl}/images/optimized/fog-shore-corner-960.webp 960w`} type="image/webp" />
      <img
        src={`${baseUrl}/images/optimized/fog-shore-corner-1440.webp`}
        alt={interludeImg.alt}
        class="interlude-bg"
        id="interludeBg"
        loading="lazy"
      />
    </picture>
    <div class="interlude-overlay"></div>
  </div>

  <div class="interlude-content container">
    <span class="interlude-coord">61° 29' 48" N · 28° 14' 12" E</span>
    <blockquote class="interlude-quote sv-reveal-heading">
      “Silence carved into the Finnish wilderness.”
    </blockquote>
    <span class="interlude-sub">SILVATIDE RETREAT · ARCHIPELAGO SAIMAA</span>
  </div>
</section>

<!-- ==========================================
     CHAPTER III: INSIDE (Horizontal Track with Inline 3D)
     ========================================== -->
<section id="chapter-inside" class="inside-section" data-tone="true" data-tone-bg="#101114" data-tone-text="#f5f5f7">
  <!-- Pinned track wrapper for desktop -->
  <div class="inside-pin-wrap" id="insidePinWrap">
    <!-- Header panel on track left -->
    <div class="inside-intro-panel">
      <span class="inside-eyebrow">CHAPTER II · INSIDE</span>
      <h2 class="inside-title sv-reveal-heading">Atmospheric Living Quarters</h2>
      <p class="inside-desc">
        Four micro-environments shaped by Finnish pine, honed stone, and changing natural daylight. Inspect the rooms as architectural photographs or explore their 3D spatial models directly inline.
      </p>
      <div class="inside-scroll-hint">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <span>SCROLL HORIZONTALLY</span>
      </div>
    </div>

    <!-- Rooms Track -->
    <div class="inside-track" id="insideTrack">
      {rooms.map((room) => (
        <article class="room-card" data-slug={room.slug} data-has-3d={room.has3D ? 'true' : 'false'}>
          <div class="room-frame">
            <!-- 1. Photographic View -->
            <div class="room-img-wrap">
              <picture>
                <source srcset={`${baseUrl}/images/optimized/${room.slug}-1440.avif 1440w, ${baseUrl}/images/optimized/${room.slug}-960.avif 960w`} type="image/avif" />
                <source srcset={`${baseUrl}/images/optimized/${room.slug}-1440.webp 1440w, ${baseUrl}/images/optimized/${room.slug}-960.webp 960w`} type="image/webp" />
                <img
                  src={`${baseUrl}/images/optimized/${room.slug}-960.webp`}
                  alt={room.img.alt}
                  class="room-photo"
                  loading="lazy"
                />
              </picture>
              <div class="room-scrim"></div>
            </div>

            <!-- Header inside frame -->
            <div class="room-card-header">
              <span class="room-tick">{room.num} / 04</span>
              <span class="room-role">{room.role}</span>
            </div>

            <!-- Footer / details inside frame -->
            <div class="room-card-footer">
              <div class="room-text">
                <h3 class="room-name">{room.name}</h3>
                <p class="room-desc">{room.desc}</p>
              </div>

              {room.has3D && (
                <button
                  class="btn-inspect-3d"
                  data-model={room.model}
                  data-room-name={room.name}
                  aria-label={`Explore ${room.name} in 3D`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                  <span>EXPLORE IN 3D</span>
                </button>
              )}
            </div>

            <!-- 2. Seamless Inline 3D Viewport (Zero intrusive popups!) -->
            {room.has3D && (
              <div class="room-inline-3d" data-model={room.model} aria-hidden="true">
                <canvas class="inline-3d-canvas" aria-label={`3D Spatial View of ${room.name}`}></canvas>
                <div class="inline-3d-header">
                  <div class="inline-3d-badge">
                    <span class="badge-dot"></span>
                    <span>INTERACTIVE 3D ROOM</span>
                  </div>
                  <button class="btn-close-inline-3d" aria-label="Return to photo view">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    <span>RETURN TO PHOTO</span>
                  </button>
                </div>
                <div class="inline-3d-loader">
                  <div class="spinner-ring"></div>
                  <span>Loading Spatial Room...</span>
                </div>
                <div class="inline-3d-hint">
                  <span>Drag to orbit · Pinch or wheel to zoom</span>
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ============================================================
     INTERLUDE STYLES
     ============================================================ */
  .interlude-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0a0c0e;
  }

  .interlude-bg-wrap {
    position: absolute;
    inset: -15% 0 -15% 0;
    width: 100%;
    height: 130%;
    z-index: 1;
  }

  .interlude-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    will-change: transform;
  }

  .interlude-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(10, 12, 14, 0.4) 0%, rgba(10, 12, 14, 0.88) 100%);
  }

  .interlude-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .interlude-coord {
    font-family: monospace;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }

  .interlude-quote {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.25;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
  }

  .interlude-sub {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
  }

  /* ============================================================
     CHAPTER III: INSIDE HORIZONTAL TRACK
     ============================================================ */
  .inside-section {
    position: relative;
    width: 100%;
    background: #101114;
    color: #f5f5f7;
    overflow: hidden;
  }

  .inside-pin-wrap {
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .inside-intro-panel {
    flex-shrink: 0;
    width: 36vw;
    min-width: 320px;
    max-width: 480px;
    padding: 0 3.5rem 0 5vw;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    z-index: 2;
  }

  .inside-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent, #e5a970);
    text-transform: uppercase;
  }

  .inside-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.2rem, 3.2vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
    color: #ffffff;
  }

  .inside-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .inside-scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 0.5rem;
  }

  .inside-track {
    display: flex;
    gap: 2.5rem;
    padding-right: 8vw;
    will-change: transform;
  }

  .room-card {
    flex-shrink: 0;
    width: 56vw;
    max-width: 820px;
    height: 72vh;
    min-height: 480px;
    max-height: 700px;
    position: relative;
  }

  .room-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #18191d;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s ease;
  }

  .room-frame:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .room-img-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    transition: opacity 0.4s ease;
  }

  .room-card.showing-3d .room-img-wrap,
  .room-card.showing-3d .room-card-footer {
    opacity: 0;
    pointer-events: none;
  }

  .room-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    transition: transform 0.8s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .room-frame:hover .room-photo {
    transform: scale(1.08);
  }

  .room-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(16, 17, 20, 0.5) 0%,
      rgba(16, 17, 20, 0.05) 40%,
      rgba(16, 17, 20, 0.85) 90%,
      rgba(16, 17, 20, 0.95) 100%
    );
    z-index: 2;
  }

  .room-card-header {
    position: relative;
    z-index: 3;
    padding: 2rem 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .room-tick {
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.5);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .room-role {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
  }

  .room-card-footer {
    position: relative;
    z-index: 3;
    padding: 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    transition: opacity 0.3s ease;
  }

  .room-text {
    max-width: 500px;
  }

  .room-name {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
  }

  .room-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  .btn-inspect-3d {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .btn-inspect-3d:hover {
    background: #ffffff;
    color: #0c0d0e;
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  /* ============================================================
     SEAMLESS INLINE 3D VIEWPORT (NO MODAL!)
     ============================================================ */
  .room-inline-3d {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: radial-gradient(circle at center, #181a20 0%, #0d0e12 100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .room-card.showing-3d .room-inline-3d {
    opacity: 1;
    pointer-events: auto;
  }

  .inline-3d-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    z-index: 1;
  }

  .inline-3d-canvas:active {
    cursor: grabbing;
  }

  .inline-3d-header {
    position: relative;
    z-index: 5;
    padding: 1.75rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .inline-3d-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--accent, #e5a970);
    background: rgba(14, 16, 20, 0.8);
    backdrop-filter: blur(8px);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent, #e5a970);
    box-shadow: 0 0 6px var(--accent, #e5a970);
  }

  .btn-close-inline-3d {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .btn-close-inline-3d:hover {
    background: #ffffff;
    color: #0c0d0e;
  }

  .inline-3d-loader {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: #14161a;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .spinner-ring {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--accent, #e5a970);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .inline-3d-hint {
    position: relative;
    z-index: 5;
    text-align: center;
    padding-bottom: 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 992px) {
    .inside-pin-wrap {
      height: auto;
      flex-direction: column;
      overflow: visible;
      padding: 5rem 1.5rem 6rem;
    }

    .inside-intro-panel {
      width: 100%;
      min-width: 0;
      max-width: 100%;
      padding: 0 0 3rem 0;
    }

    .inside-scroll-hint {
      display: none;
    }

    .inside-track {
      flex-direction: column;
      gap: 3rem;
      padding-right: 0;
      width: 100%;
      transform: none !important;
    }

    .room-card {
      width: 100%;
      max-width: 100%;
      height: 60vh;
      min-height: 400px;
    }

    .room-card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.5rem;
    }

    .room-card-header {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interlude-bg,
    .inside-track,
    .room-photo {
      transform: none !important;
      transition: none !important;
    }
    .inside-pin-wrap {
      height: auto;
      flex-direction: column;
    }
    .inside-track {
      flex-direction: column;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initInsideExperience() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 993px)').matches;

    // 1. Interlude Parallax
    const interludeSection = document.getElementById('chapter-interlude');
    const interludeBg = document.getElementById('interludeBg');
    if (interludeSection && interludeBg && !prefersReducedMotion) {
      gsap.fromTo(
        interludeBg,
        { yPercent: -8 },
        {
          yPercent: 8,
          ease: 'none',
          scrollTrigger: {
            trigger: interludeSection,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true
          }
        }
      );
    }

    // 2. Desktop Horizontal Pin Track
    const insidePinWrap = document.getElementById('insidePinWrap');
    const insideTrack = document.getElementById('insideTrack');
    const insideSection = document.getElementById('chapter-inside');

    if (isDesktop && !prefersReducedMotion && insidePinWrap && insideTrack && insideSection) {
      const getScrollAmount = () => {
        const trackWidth = insideTrack.scrollWidth;
        const viewportWidth = window.innerWidth;
        const introWidth = document.querySelector('.inside-intro-panel')?.getBoundingClientRect().width || 400;
        return -(trackWidth - (viewportWidth - introWidth) + 120);
      };

      const horizontalScroll = gsap.to(insideTrack, {
        x: () => getScrollAmount(),
        ease: 'none',
        scrollTrigger: {
          trigger: insideSection,
          pin: true,
          scrub: 0.8,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          start: 'top top',
          end: () => `+=${insideTrack.scrollWidth - window.innerWidth + 500}`
        }
      });

      // Subtle inner parallax on photos
      const photos = insideTrack.querySelectorAll('.room-photo');
      photos.forEach((photo) => {
        gsap.fromTo(
          photo,
          { xPercent: 4 },
          {
            xPercent: -4,
            ease: 'none',
            scrollTrigger: {
              trigger: photo.closest('.room-card'),
              containerAnimation: horizontalScroll,
              start: 'left right',
              end: 'right left',
              scrub: true
            }
          }
        );
      });
    }

    // 3. Seamless Inline 3D Card Viewer
    setupInline3DViewers();
  }

  // Active instances for cleanup
  const activeViewers = new Map();

  function setupInline3DViewers() {
    const cards = document.querySelectorAll('.room-card');

    cards.forEach((card) => {
      const inspectBtn = card.querySelector('.btn-inspect-3d');
      const closeBtn = card.querySelector('.btn-close-inline-3d');
      const inlineContainer = card.querySelector('.room-inline-3d') as HTMLElement;
      const canvas = card.querySelector('.inline-3d-canvas') as HTMLCanvasElement;
      const loaderEl = card.querySelector('.inline-3d-loader') as HTMLElement;

      if (!inspectBtn || !closeBtn || !inlineContainer || !canvas) return;

      inspectBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        card.classList.add('showing-3d');
        inlineContainer.setAttribute('aria-hidden', 'false');

        const modelUrl = inlineContainer.dataset.model;
        if (!modelUrl) return;

        // Initialize 3D on that canvas if not already created
        if (!activeViewers.has(card)) {
          if (loaderEl) loaderEl.style.opacity = '1';
          const viewerInstance = await initCard3D(canvas, modelUrl, loaderEl);
          activeViewers.set(card, viewerInstance);
        } else {
          const viewer = activeViewers.get(card);
          viewer?.resume();
        }
      });

      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        card.classList.remove('showing-3d');
        inlineContainer.setAttribute('aria-hidden', 'true');
        const viewer = activeViewers.get(card);
        viewer?.pause();
      });
    });
  }

  async function initCard3D(canvas: HTMLCanvasElement, modelUrl: string, loaderEl: HTMLElement | null) {
    const [THREE, { OrbitControls }, { GLTFLoader }, { MeshoptDecoder }] = await Promise.all([
      import('three'),
      import('three/examples/jsm/controls/OrbitControls.js'),
      import('three/examples/jsm/loaders/GLTFLoader.js'),
      import('meshoptimizer')
    ]);

    const rect = canvas.getBoundingClientRect();
    const width = rect.width || 600;
    const height = rect.height || 450;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x101216);

    const camera = new THREE.PerspectiveCamera(40, width / height, 0.05, 50);
    camera.position.set(0.65, 0.45, 0.65);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.maxPolarAngle = Math.PI / 2 + 0.05;
    controls.minDistance = 0.3;
    controls.maxDistance = 2.5;

    // Warm Interior Nordic Lighting
    const hemiLight = new THREE.HemisphereLight(0xfff8ee, 0x1a1c24, 1.4);
    scene.add(hemiLight);

    const keyLight = new THREE.DirectionalLight(0xffecd2, 2.2);
    keyLight.position.set(2, 4, 3);
    scene.add(keyLight);

    const softFill = new THREE.DirectionalLight(0x8899aa, 0.8);
    softFill.position.set(-2, 1, -2);
    scene.add(softFill);

    // Floor Accent Grid
    const grid = new THREE.GridHelper(2, 20, 0x2a2e38, 0x1c1e24);
    grid.position.y = -0.01;
    scene.add(grid);

    // Load Model
    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);

    loader.load(
      modelUrl,
      (gltf) => {
        const model = gltf.scene;

        // Center model
        const box = new THREE.Box3().setFromObject(model);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z);

        const targetScale = 0.85 / maxDim;
        model.scale.setScalar(targetScale);
        model.position.sub(center.multiplyScalar(targetScale));
        model.position.y += (size.y * targetScale) / 2;
        model.traverse((c: any) => {
          if (c.isMesh && c.material) {
            c.material.side = THREE.DoubleSide;
            c.material.roughness = 0.65;
            c.material.metalness = 0.1;
          }
        });

        scene.add(model);
        controls.target.set(0, (size.y * targetScale) / 2, 0);
        controls.update();

        if (loaderEl) loaderEl.style.opacity = '0';
      },
      undefined,
      (err) => {
        console.error('Failed to load inline room model:', err);
      }
    );

    let isRunning = true;
    let animId = 0;

    const animate = () => {
      if (!isRunning) return;
      animId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    };
    animate();

    return {
      pause: () => { isRunning = false; cancelAnimationFrame(animId); },
      resume: () => {
        if (!isRunning) {
          isRunning = true;
          animate();
        }
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInsideExperience);
  } else {
    initInsideExperience();
  }

  document.addEventListener('astro:page-load', initInsideExperience);
</script>
