---
// Gallery.astro
---

<section class="gallery-section section-padding">
  <div class="gallery-wrapper fade-up">
    <div class="gallery-track">
      <!-- First Set -->
      <div class="gallery-item item-1">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_t5hys4t5hys4t5hy.png`} alt="Exterior dusk" loading="lazy" />
      </div>
      <div class="gallery-item item-2">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_7yfyyl7yfyyl7yfy.png`} alt="Bathroom" loading="lazy" />
      </div>
      <div class="gallery-item item-3">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_3cpd8v3cpd8v3cpd.png`} alt="Living room" loading="lazy" />
      </div>
      <div class="gallery-item item-4">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_h823xhh823xhh823.png`} alt="Deck" loading="lazy" />
      </div>
      <div class="gallery-item item-5">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_sxrulusxrulusxru.png`} alt="Kitchen" loading="lazy" />
      </div>
      
      <!-- Duplicated Set for Infinite Rotation -->
      <div class="gallery-item item-1">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_t5hys4t5hys4t5hy.png`} alt="Exterior dusk" loading="lazy" />
      </div>
      <div class="gallery-item item-2">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_7yfyyl7yfyyl7yfy.png`} alt="Bathroom" loading="lazy" />
      </div>
      <div class="gallery-item item-3">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_3cpd8v3cpd8v3cpd.png`} alt="Living room" loading="lazy" />
      </div>
      <div class="gallery-item item-4">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_h823xhh823xhh823.png`} alt="Deck" loading="lazy" />
      </div>
      <div class="gallery-item item-5">
        <img src={`${import.meta.env.BASE_URL}images/Gemini_Generated_Image_sxrulusxrulusxru.png`} alt="Kitchen" loading="lazy" />
      </div>
    </div>
  </div>

  <div class="container gallery-text-content fade-up" style="transition-delay: 0.2s;">
    <h2 class="gallery-title">A retreat shaped by forest and water</h2>
    <p class="gallery-desc">
      Silvatide Cottage is a contemporary lakeside escape where clean architecture meets natural calm. Framed by pine forest and open water, it offers a slower, more intentional stay in a space designed for comfort, light, and silence.
    </p>
  </div>
</section>

<style>
  .gallery-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  .gallery-wrapper {
    width: 100vw;
    overflow: hidden;
    position: relative;
    padding: 3rem 0;
    margin-bottom: 3rem;
  }

  .gallery-track {
    display: flex;
    gap: 2rem;
    width: max-content;
    align-items: center;
    /* The animation takes 30s to scroll half the track (one set of images) */
    animation: scroll-gallery 30s linear infinite;
  }

  .gallery-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-gallery {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 1rem));
    }
  }

  .gallery-item {
    flex: 0 0 auto;
    border-radius: 12px;
    overflow: hidden;
    transition: transform var(--transition-slow);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Creating the staggered look from the design */
  .item-1 { width: 250px; height: 350px; transform: translateY(20px); }
  .item-2 { width: 230px; height: 450px; transform: translateY(-30px); }
  .item-3 { width: 280px; height: 400px; }
  .item-4 { width: 230px; height: 450px; transform: translateY(30px); }
  .item-5 { width: 250px; height: 350px; transform: translateY(-10px); }

  .gallery-item:hover {
    transform: scale(1.05) translateY(0) !important;
    z-index: 10;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .gallery-text-content {
    text-align: center;
    max-width: 400px;
    margin: 0 auto;
  }

  .gallery-title {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .gallery-desc {
    font-size: 1.05rem;
  }

  @media (max-width: 992px) {
    .gallery-item {
      transform: none !important;
    }
  }
</style>
